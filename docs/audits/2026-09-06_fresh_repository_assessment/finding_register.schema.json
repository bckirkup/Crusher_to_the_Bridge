{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crusher integrated finding register \u2014 r11 corrected synthesis",
  "type": "object",
  "required": [
    "schema_version",
    "source_sha",
    "finding_count",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "source_sha": {
      "const": "07561adf2b93ff6b358859fb382b253c08828156"
    },
    "finding_count": {
      "type": "integer",
      "minimum": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "claim",
          "evidence_class",
          "source_sha",
          "artifact_path",
          "artifact_ref",
          "component",
          "severity",
          "confidence",
          "consequence",
          "remediation",
          "dependencies",
          "acceptance_test"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "evidence_class": {
            "type": "string"
          },
          "source_sha": {
            "type": "string"
          },
          "artifact_path": {
            "type": "string"
          },
          "artifact_ref": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "consequence": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_test": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
