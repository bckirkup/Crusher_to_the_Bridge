  "surveillance_tier_notes": {
    "inv_baseline": "Spec \u00a74 Baseline: syndromic sick-call only, no sequencing.",
    "inv_minimal": "Spec \u00a74 Minimal: clinical qPCR/amplicon typing via the cascade.",
    "inv_moderate": "Spec \u00a74 Moderate: cascade + Nanopore verification + amplicon wastewater with lineage deconvolution.",
    "inv_full": "Spec \u00a74 Full: Moderate plus surface sampling and a deeper, long-read wastewater library."
  },
  "surveillance_configs": {
