{
  "campaign": "paper3_fleet_network_value_v1",
  "platform": "mega_cruise_5000",
  "description": "Paper 3 design 3 (spec \u00a76 'Fleet network value', ~3,000 runs): independent single-ship voyages across all four hulls, pooled in post-processing into fleets of ten to compare fleet against single-ship detection power. Each run is one ship; the fleet is an analysis-time aggregation, so no new engine coupling is implied. Hourly clock, drawn-incubation arm.",
  "natural_history_clock": "hours",
  "incubation_arm": "distribution",
  "epoch_duration_hours": 1,
  "default_epochs": 168,
  "default_num_agents": 7000,
  "defaults": {
    "dose_adjustment": 12.0,
    "initial_infected": 1,
    "voyage_days": [
      7
    ],
    "founder_strains": [
      1
    ],
    "census_interval_epochs": 6
  },
  "pathogen_configs": {
    "norovirus": {
      "bundle": "active_profiles",
      "pathogen_id": "norwalk_gi",
      "wastewater_label": "norovirus",
