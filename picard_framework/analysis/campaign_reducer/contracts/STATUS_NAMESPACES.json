  "lifecycle_alias_rule": "Operational aliases apply only to reduction_attempts.status/receipts.status with retained reason/receipt evidence; historical scientific stopped labels are retained in provenance, never interpreted as lost data. completed requires explicit phase-completion evidence; no default unknown-to-completed mapping.",
  "metric_alias_rule": "An unavailable/undefined value retains null plus a separate data_gaps reason/detail; censorship is encoded in times_to_event.censor_type, never a seventh metrics.value_status. No zero imputation.",
  "capability_alias_rule": "Source narrative labels remain verbatim in evidence_detail/provenance. Conditions are evidence requirements, not source-label synonyms; historical census labels/rows are not rewritten.",
  "narrative_gap_reasons": {
    "documented_unverified": "not_requested",
    "not_saved": "not_saved",
    "count_not_retained": "not_saved",
    "counted_not_retained": "not_saved",
    "not_observed": "not_observed",
    "not_applicable": "not_applicable",
    "zero_denominator": "denominator_zero",
    "unknown_definition": "incompatible_definition",
    "censored": "partial_followup",
    "unsupported": "unknown_schema",
    "corrupt": "malformed",
    "source_changed": "identity_unresolved",
    "access_blocked": "unreachable",
    "resource_blocked": "unreachable",
    "unknown": "not_identifiable"
  },
  "narrative_gap_rule": "Use these generic reasons only when the named condition is evidenced; otherwise unknown/unverified detail remains explicit (not_identifiable or not_requested as applicable). Retain original label, precise reason and evidence in data_gaps.detail; no automatic fabricated missingness evidence.",
  "historical_stop_rule": "Historical stopped labels stay in historical scientific provenance and are not automatically converted into completed, checkpointed or data-loss states. A reducer checkpointed status requires actual checkpoint evidence."
}
