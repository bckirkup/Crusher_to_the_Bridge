{
  "$id": "urn:crusher:integrated-distributions:v1:bootstrap",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission": {
      "additionalProperties": false,
      "properties": {
        "admission_id": {
          "minLength": 1,
          "type": "string"
        },
        "approved_cost_usd": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "approved_scope_hash": {
          "minLength": 1,
          "type": "string"
        },
        "expires_utc": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "admission_id",
        "approved_scope_hash",
        "approved_cost_usd",
        "expires_utc"
      ],
      "type": "object"
    },
    "budgets": {
      "additionalProperties": false,
      "properties": {
        "max_api_calls_total": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "max_cost_usd": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "max_head_requests": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "max_list_pages": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "max_return_bytes": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "max_source_objects": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "max_wall_seconds": {
          "exclusiveMinimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_api_calls_total",
        "max_list_pages",
        "max_head_requests",
        "max_source_objects",
        "max_return_bytes",
        "max_wall_seconds",
        "max_cost_usd"
      ],
      "type": "object"
    },
    "collect_page_ids": {
      "description": "optional: collect only these pages manifest page_ids/uris",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "collect_page_limit": {
      "description": "optional: collect only the first N manifest pages",
      "minimum": 1,
      "type": "integer"
    },
    "collect_all_pages": {
      "description": "optional: collect every selected manifest page in bounded legs (files_per_collect and total_bytes_per_collect apply per leg)",
      "type": "boolean"
    },
    "derived_exclude_prefixes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "operation": {
      "enum": [
        "preflight",
        "inventory",
        "status",
        "collect",
        "acknowledge"
      ]
    },
    "price_snapshot": {
      "additionalProperties": false,
      "properties": {
        "as_of_utc": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "unit_prices_json": {
          "minProperties": 1,
          "type": "object"
        }
      },
      "required": [
        "id",
        "as_of_utc",
        "unit_prices_json"
      ],
      "type": "object"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "crusher-campaign-distributions/1.0-proposed"
    },
    "scope_register_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_bucket": {
      "minLength": 1,
      "type": "string"
    },
    "source_roots_allowlist": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "operation",
    "source_bucket",
    "source_roots_allowlist",
    "derived_exclude_prefixes",
    "scope_register_sha256",
    "budgets",
    "admission",
    "price_snapshot"
  ],
  "title": "NOT_YET_IMPLEMENTED bounded metadata/return admission; no Batch submit or payload reduction",
  "type": "object"
}
