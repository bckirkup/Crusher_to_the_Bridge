    },
    {
      "column": "scan_n_late_ev",
      "kind": "value",
      "native": "/census/n_late_ev"
    }
  ],
  "scan_join": {
    "fallback": "none",
    "note": "scan row `key` is the run archive object key; full-key only \u2014 off/ps_ship share seeds within a hull so (hull,seed) is ambiguous; key/hull/seed disagreement or a duplicate key is a typed conflict, never first-row-wins",
    "primary": "object_key"
  },
  "scan_role": "scan_rows",
  "status_vocabulary": [
    "domain_invalid",
    "exact_emitted",
    "invalid_pair_missing_operand",
    "invalid_pair_zero_denominator",
    "missing",
    "null_emitted",
    "recomputed",
    "recomputed_pair",
    "scan_agreement_conflict",
    "scan_key_conflict",
    "scan_source_absent",
    "sum_consistent",
    "sum_divergent",
    "sum_uncomputable",
    "unknown"
  ],
  "sum_checks": [
    {
      "column": "reported_by_channel_consistent",
      "dict_column": "reported_cases_by_channel_json",
      "role_totals": {
        "crew": "cumulative_reported_cases_crew",
        "passenger": "cumulative_reported_cases_passenger"
      },
      "sum_column": "reported_by_channel_sum",
      "total_column": "cumulative_reported_cases"
    },
    {
      "column": "reported_by_route_consistent",
      "dict_column": "reported_cases_by_dominant_route_json",
      "role_totals": {
        "crew": "cumulative_reported_cases_crew",
        "passenger": "cumulative_reported_cases_passenger"
      },
      "sum_column": "reported_by_route_sum",
      "total_column": "cumulative_reported_cases"
    },
    {
      "column": "infections_by_route_consistent",
      "dict_column": "infections_by_dominant_route_json",
      "historical_evidence": true,
      "note": "CONFLATED definition retained as historical evidence: compares acquired-route member sums against cumulative_ever_infected (imports + acquired), so it diverges by exactly n_imports on every run with imports. Superseded by infections_by_route_vs_acquired_consistent and imports_plus_acquired_vs_ever_infected_consistent.",
      "sum_column": "infections_by_route_sum",
      "total_column": "cumulative_ever_infected"
    },
    {
      "column": "infections_by_route_vs_acquired_consistent",
      "dict_column": "infections_by_dominant_route_json",
      "note": "Dominant-route acquisition counts are acquired infections only; the correct comparator is census.n_acquired.",
      "sum_column": "infections_by_route_vs_acquired_sum",
      "total_column": "census_n_acquired"
    }
  ],
