{
  "definition_version": "first_paper_scalar/1.5.0",
  "description": "One wide row per selected actual execution for the first cruise norovirus paper: summary.json-only member reads, declared field projection, per-field provenance, explicit missingness (never zero), no all-leaf scalarization, no distributions/ECDF materialization, no census decode. 1.3.0 added the compact observed-window witness fields. 1.4.0 adds the Phase-2 venue-pin extraction fields (source_venue_arm, actual_venues_used, n_lots_placed) range-read from summary.mechanisms.provisioned_source — additive only, every 1.3.0 column unchanged. 1.5.0 adds the cumulative role-checkpoint sidecar (PAPER1-SENS Child A): for voyage days 3/7/10/12 (hourly epoch boundary 24*d, snapshot at the end of epoch index 24*d/hours_per_epoch - 1) and separately for passenger/crew, unique-person counts range-read from summary.role_checkpoints.checkpoints (infected, ill, unique etiologic reporters, unique clinical-noise reporters, their overlap, unique-person union, union members satisfying clinical eligibility, complement) plus per-day observed clock and availability, and the sidecar's definitions/clock JSON — additive only, every 1.4.0 column unchanged. Union/overlap are set cardinalities emitted by the engine, never recovered from totals; the reporter union is a sick-call presentation set, not a matched clinical-AGE endpoint.",
  "emit_scalars": false,
  "kind": "extraction_profile",
  "member_allowlist": [
    "summary.json"
  ],
  "observation_fields": [
    {
      "column": "observed_first_epoch",
      "derive": "first_epoch",
      "window": "timeseries"
    },
    {
      "column": "observed_terminal_epoch",
      "derive": "last_epoch",
      "window": "timeseries"
    },
    {
      "column": "retained_epoch_rows",
      "derive": "row_count",
      "window": "timeseries"
    },
    {
      "column": "epoch_index_contiguous",
      "derive": "contiguous",
      "window": "timeseries"
    }
  ],
  "operand_sum_checks": [
    {
      "addends": [
        "census_n_imports",
        "census_n_acquired"
      ],
      "column": "imports_plus_acquired_vs_ever_infected_consistent",
      "note": "Every infected person is either an import or an aboard acquisition; verified independent of the route histogram.",
      "sum_column": "imports_plus_acquired_sum",
      "total_column": "cumulative_ever_infected"
    },
    {
      "addends": [
        "rc_d12_passenger_union_ever_ill",
        "rc_d12_passenger_union_not_ill"
      ],
      "column": "rc_d12_passenger_union_eligibility_partition_consistent",
      "note": "The reporter union partitions exactly into members who satisfied clinical eligibility (ever ill) and members who never did; verifies the emitted sets are consistent without recovering the union from totals.",
      "sum_column": "rc_d12_passenger_union_eligibility_partition_sum",
      "total_column": "rc_d12_passenger_unique_person_union"
    },
    {
      "addends": [
        "rc_d12_crew_union_ever_ill",
        "rc_d12_crew_union_not_ill"
      ],
      "column": "rc_d12_crew_union_eligibility_partition_consistent",
      "note": "The reporter union partitions exactly into members who satisfied clinical eligibility (ever ill) and members who never did; verifies the emitted sets are consistent without recovering the union from totals.",
      "sum_column": "rc_d12_crew_union_eligibility_partition_sum",
      "total_column": "rc_d12_crew_unique_person_union"
    }
  ],
  "profile_id": "first_paper_scalar",
  "recomputed_pairs": [
    {
      "column": "attack_rate_infection_pax_recomputed",
      "denominator": "passenger_complement",
      "numerator": "cumulative_ever_infected_passenger"
    },
    {
      "column": "attack_rate_infection_crew_recomputed",
      "denominator": "crew_complement",
      "numerator": "cumulative_ever_infected_crew"
    },
    {
      "column": "attack_rate_ill_pax_recomputed",
