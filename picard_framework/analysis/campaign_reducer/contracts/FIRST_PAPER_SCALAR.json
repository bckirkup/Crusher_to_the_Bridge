  "suppress_tables": ["run_scalars", "distributions", "weights"],
  "emit_scalars": false,
  "scan_role": "scan_rows",
  "scan_join": {
    "primary": "object_key",
    "fallback": "hull_seed",
    "note": "scan row `key` is the run archive object key; `hull`+`seed` is the fused-archive fallback"
  },
  "summary_fields": [
