    {
      "column": "infections_by_route_consistent",
      "dict_column": "infections_by_dominant_route_json",
      "historical_evidence": true,
      "note": "CONFLATED definition retained as historical evidence: compares acquired-route member sums against cumulative_ever_infected (imports + acquired), so it diverges by exactly n_imports on every run with imports. Superseded by infections_by_route_vs_acquired_consistent and imports_plus_acquired_vs_ever_infected_consistent.",
      "sum_column": "infections_by_route_sum",
      "total_column": "cumulative_ever_infected"
    },
    {
      "column": "infections_by_route_vs_acquired_consistent",
      "dict_column": "infections_by_dominant_route_json",
      "note": "Dominant-route acquisition counts are acquired infections only; the correct comparator is census.n_acquired.",
