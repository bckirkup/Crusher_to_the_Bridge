{
  "definition_version": "first_paper_scalar/1.2.0",
  "description": "One wide row per selected actual execution for the first cruise norovirus paper: summary.json-only member reads, declared field projection, per-field provenance, explicit missingness (never zero), no all-leaf scalarization, no distributions/ECDF materialization, no census decode.",
  "emit_scalars": false,
  "kind": "extraction_profile",
  "member_allowlist": [
    "summary.json"
  ],
  "operand_sum_checks": [
    {
      "addends": [
        "census_n_imports",
        "census_n_acquired"
      ],
      "column": "imports_plus_acquired_vs_ever_infected_consistent",
      "note": "Every infected person is either an import or an aboard acquisition; verified independent of the route histogram.",
      "sum_column": "imports_plus_acquired_sum",
      "total_column": "cumulative_ever_infected"
    }
  ],
  "profile_id": "first_paper_scalar",
  "recomputed_pairs": [
    {
      "column": "attack_rate_infection_pax_recomputed",
      "denominator": "passenger_complement",
      "numerator": "cumulative_ever_infected_passenger"
    },
    {
      "column": "attack_rate_infection_crew_recomputed",
      "denominator": "crew_complement",
      "numerator": "cumulative_ever_infected_crew"
    },
    {
      "column": "attack_rate_ill_pax_recomputed",
      "denominator": "passenger_complement",
      "numerator": "cumulative_ever_ill_passenger"
    },
    {
      "column": "attack_rate_ill_crew_recomputed",
      "denominator": "crew_complement",
      "numerator": "cumulative_ever_ill_crew"
    },
    {
      "column": "reported_rate_pax_recomputed",
      "denominator": "passenger_complement",
      "numerator": "cumulative_reported_cases_passenger"
    },
    {
      "column": "reported_rate_crew_recomputed",
      "denominator": "crew_complement",
      "numerator": "cumulative_reported_cases_crew"
    }
  ],
  "scan_fields": [
    {
      "column": "scan_posted",
      "kind": "value",
      "native": "/posted"
    },
    {
      "column": "scan_vsp_trigger",
      "kind": "value",
      "native": "/vsp_trigger"
    },
    {
