    "fallback": "none",
    "note": "scan row `key` is the run archive object key; full-key only — off/ps_ship share seeds within a hull so (hull,seed) is ambiguous; key/hull/seed disagreement or a duplicate key is a typed conflict, never first-row-wins",
    "primary": "object_key"
  },
  "scan_role": "scan_rows",
  "status_vocabulary": [
    "domain_invalid",
