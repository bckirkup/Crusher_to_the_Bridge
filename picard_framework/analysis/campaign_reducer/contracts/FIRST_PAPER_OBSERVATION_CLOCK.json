    },
    {
      "column": "terminal_ts_ever_infected",
      "derive": "last_value",
      "ts_key": "cumulative_ever_infected"
    },
    {
      "category": "etiologic_report",
      "column": "first_etiologic_report_passenger_epoch",
      "derive": "first_gt0",
      "origin": "timeseries:cumulative_reported_cases_passenger",
      "role": "passenger",
