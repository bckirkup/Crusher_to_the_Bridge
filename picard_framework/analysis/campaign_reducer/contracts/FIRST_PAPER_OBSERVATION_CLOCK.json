{
  "availability_fields": [
    {
      "availability": "not_recorded",
      "column": "noise_reports_passenger",
      "evidence": "orchestrator_record._summary_counts writes cumulative_reported_noise_cases as a single fleet total; state.ever_reported_noise_ids exists but its members' roles are never split at emission. Not inferable from population proportions.",
      "reason_code": "role_split_never_emitted"
    },
    {
      "availability": "not_recorded",
      "column": "noise_reports_crew",
      "evidence": "same as noise_reports_passenger.",
      "reason_code": "role_split_never_emitted"
    },
    {
      "availability": "not_recoverable",
      "column": "reported_persons_overlap_etiologic_noise",
      "evidence": "state.ever_reported_ids and state.ever_reported_noise_ids are SimulationState sets; _summary_counts serializes len() only; compact history drops syn_result; the growth_census payload carries transmission-chain rows only. Sets are disjoint within an epoch by construction but NOT across epochs.",
      "reason_code": "person_id_sets_not_serialized"
    },
    {
      "availability": "not_recoverable",
      "column": "reported_persons_union_etiologic_noise",
      "evidence": "union requires |A intersect B| (FIELD_CONTRACTS reported_noise_count.v1: never sum unless disjoint IDs proved); the intersection is not recoverable.",
      "reason_code": "person_id_sets_not_serialized"
    },
    {
      "availability": "not_recorded_in_run_archive",
      "column": "embarkation_wall_date",
      "evidence": "parameters carry natural_history_clock and initiation.manifest.boarding_epoch only; the embarkation calendar date lives in the campaign manifest (noro_provisioned_source_01_manifest.json), not the run zip.",
      "reason_code": "date_anchor_is_campaign_manifest_level"
    },
    {
      "availability": "not_recoverable",
      "column": "per_epoch_sick_call_rosters",
      "evidence": "epoch syn_result (sick_call_agents, true_positive_ids, noise_ids, first_detection_events, onset_observations) is excluded by the compact-history filter; only scalar counters survive.",
      "reason_code": "compact_history_drops_rosters"
    }
  ],
  "definition_version": "first_paper_observation_clock/1.0.0",
  "description": "Observation/clock sidecar for the red-fps01-b cohort, joined by exact existing execution/source identity: report counts by role, observed (not configured) terminal epoch and retained trajectory coverage, first-report and threshold-crossing times labelled with category/clock/origin/window, scanner provenance, and typed availability declarations for fields the producing version never serialized. summary.json-only member reads; no census/event decode; null with a typed status, never a manufactured value.",
  "emit_scalars": false,
  "equality_checks": [
    {
      "column": "terminal_ts_reported_vs_summary_consistent",
      "left": "terminal_ts_reported",
      "right": "cumulative_reported_cases"
    },
    {
      "column": "terminal_ts_reported_passenger_vs_summary_consistent",
      "left": "terminal_ts_reported_passenger",
      "right": "cumulative_reported_cases_passenger"
    },
    {
      "column": "terminal_ts_reported_crew_vs_summary_consistent",
      "left": "terminal_ts_reported_crew",
      "right": "cumulative_reported_cases_crew"
    },
    {
      "column": "terminal_ts_noise_vs_summary_consistent",
      "left": "terminal_ts_noise",
      "right": "cumulative_reported_noise_cases"
    },
    {
      "column": "terminal_ts_ever_infected_vs_summary_consistent",
      "left": "terminal_ts_ever_infected",
      "right": "cumulative_ever_infected"
    },
    {
      "column": "vsp_ts_vs_derived_consistent",
      "left": "vsp_either_channel_first_epoch",
      "right": "derived_vsp_trigger_epoch"
    },
    {
      "column": "detection_ts_vs_derived_consistent",
      "left": "detection_epoch_ts",
      "right": "derived_detection_epoch"
    },
    {
      "column": "confirmation_ts_vs_derived_consistent",
      "left": "confirmation_epoch_ts",
      "right": "derived_confirmation_epoch"
    }
  ],
  "kind": "extraction_profile",
  "member_allowlist": [
    "summary.json"
  ],
  "observation_fields": [
