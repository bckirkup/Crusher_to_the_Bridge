    },
    {
      "category": "etiologic_report",
      "column": "first_etiologic_report_crew_epoch",
      "derive": "first_gt0",
      "origin": "timeseries:cumulative_reported_cases_crew",
      "role": "crew",
      "ts_key": "cumulative_reported_cases_crew"
    },
    {
      "category": "etiologic_report",
      "column": "first_etiologic_report_epoch",
      "derive": "first_gt0",
      "origin": "timeseries:cumulative_reported_cases",
      "role": "any",
      "ts_key": "cumulative_reported_cases"
    },
    {
      "category": "noise_report",
      "column": "first_noise_report_epoch",
      "derive": "first_gt0",
      "origin": "timeseries:cumulative_reported_noise_cases",
      "role": "all (no role split serialized)",
      "ts_key": "cumulative_reported_noise_cases"
    },
    {
      "category": "symptomatic_prevalence",
      "column": "first_symptomatic_epoch",
      "derive": "first_gt0",
      "origin": "timeseries:symptomatic",
      "ts_key": "symptomatic"
    },
    {
      "category": "confinement",
      "column": "first_quarantined_epoch",
      "derive": "first_gt0",
      "origin": "timeseries:quarantined",
      "ts_key": "quarantined"
    },
    {
      "category": "confinement",
      "column": "first_isolated_epoch",
      "derive": "first_gt0",
      "origin": "timeseries:isolated",
      "ts_key": "isolated"
    },
    {
      "category": "vsp_threshold",
      "column": "vsp_either_channel_first_epoch",
      "derive": "first_any_flag",
      "origin": "timeseries:*_reported_case_rate_exceeded (VSP-EITHER-CHANNEL-01 either-channel rule)",
      "ts_keys": [
        "passenger_reported_case_rate_exceeded",
        "crew_reported_case_rate_exceeded"
      ]
    },
    {
      "category": "trigger_detection",
      "column": "detection_epoch_ts",
      "derive": "first_status_in",
      "origin": "timeseries:trigger_status",
      "ts_key": "trigger_status",
      "values": [
        "SUSPECTED",
        "CONFIRMED"
      ]
    },
    {
      "category": "trigger_confirmation",
      "column": "confirmation_epoch_ts",
      "derive": "first_status_in",
      "origin": "timeseries:trigger_status",
      "ts_key": "trigger_status",
      "values": [
        "CONFIRMED"
      ]
    }
  ],
  "operand_sum_checks": [
