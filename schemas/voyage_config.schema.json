{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crusher-to-the-bridge/schemas/voyage_config.schema.json",
  "title": "VoyageConfig",
  "description": "Cruise voyage itinerary, platform dining meal weights, and medical response knobs (ship operations layer).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string" },
    "platform_class": {
      "type": "string",
      "description": "Hull class of the platform this itinerary belongs to. The first four are the cruise platforms in data/platforms/; constitution and galaxy are the fictional Enterprise platforms (docs/paper3/variant_surveillance_spec.md §3). Consumed as an opaque grouping label (sentinel itinerary/line-list metadata), so adding a class does not change any behaviour keyed on the cruise four.",
      "enum": [
        "expedition",
        "classic",
        "spirit",
        "mega",
        "constitution",
        "galaxy"
      ]
    },
    "description": { "type": "string" },
    "voyage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "effects_enabled": {
          "type": "boolean",
          "default": false,
          "description": "When false (default), EpochState is identity sea-day; ashore/contact/dining/embarkation effects are not applied."
        },
        "total_epochs": { "type": "integer", "minimum": 1 },
        "embarkation_date": {
          "type": "string",
          "format": "date",
          "description": "Real-world date of voyage day 1 (YYYY-MM-DD). Simulation-inert; sentinel analysis derives per-day calendar dates from it."
        },
        "epoch_duration_hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1,
          "description": "Physical duration of one epoch in hours. The natural-history clock converts day-valued pathogen parameters through this, so it must agree with any top-level epoch_duration_hours; a disagreement is refused rather than silently resolved."
        },
        "natural_history_clock": {
          "type": "string",
          "enum": ["hours", "legacy_epoch_day"],
          "default": "hours",
          "description": "hours (default): one epoch lasts epoch_duration_hours of physical time and day-valued pathogen parameters are converted. legacy_epoch_day: one epoch is one day of natural history regardless of the voyage grid, retained only as the historical control arm for paired sensitivity analysis."
        },
        "itinerary": {
          "type": "array",
          "items": { "$ref": "#/$defs/itinerary_day" }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "sea_day": { "$ref": "#/$defs/day_defaults" },
            "port_day": { "$ref": "#/$defs/day_defaults" },
            "embarkation": { "$ref": "#/$defs/day_defaults" },
            "disembarkation": { "$ref": "#/$defs/day_defaults" }
          }
        },
        "shore_exposure": {
          "type": "object",
          "additionalProperties": true,
          "description": "Port exposure gate, narrower than effects_enabled: crew shore leave and shore pathogen introduction. Both require this to be enabled.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "When false (default), crew stay aboard and shore_infection_probability_per_hour introduces nothing, so runs are bit-identical to pre-shore-exposure behavior."
            }
          }
        }
      }
    },
    "dining_meal_weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "breakfast": { "$ref": "#/$defs/meal_weights" },
        "lunch": { "$ref": "#/$defs/meal_weights" },
        "dinner": { "$ref": "#/$defs/meal_weights" }
      }
    },
    "medical_response": { "$ref": "#/$defs/medical_response" },
    "ship_functions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Ship-function capacity declarations (docs/proposals/ship_function_capacity_spec.md §3): function instances keyed by (function_id, serves), scored each epoch from crew availability. enabled: false by default; absent = bit-identical.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "symptomatic_effectiveness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of a watch a symptomatic-but-present crew member delivers. Null-sourced declared arm; never anchor-fitted."
        },
        "functions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ship_function" }
        }
      }
    },
    "ship_systems": {
      "type": "array",
      "description": "Named ship systems with health state, degradation, and repair labor (spec §5).",
      "items": { "$ref": "#/$defs/ship_system" }
    },
    "hazard_sources": {
      "type": "object",
      "additionalProperties": true,
      "description": "Hazard source-model declarations (docs/proposals/ship_function_capacity_spec.md §8, ENV-SOURCE-01): substances riding the environmental reservoirs, emitters writing into env_contamination zone pools, and off-ship field penetrations resolved through named adapters. enabled: false by default; absent = bit-identical. All rates are *_per_hour / *_hours and carry source+grade (NULL-SOURCE for declared arms).",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "substances": {
          "type": "array",
          "items": { "$ref": "#/$defs/hazard_substance" }
        },
        "emitters": {
          "type": "array",
          "items": { "$ref": "#/$defs/hazard_emitter" }
        },
        "penetrations": {
          "type": "array",
          "items": { "$ref": "#/$defs/hazard_penetration" }
        }
      }
    }
  },
  "$defs": {
    "ship_function": {
      "type": "object",
      "required": ["function_id", "serves"],
      "additionalProperties": true,
      "properties": {
        "function_id": { "type": "string" },
        "serves": {
          "type": "string",
          "enum": ["passengers", "crew", "both", "mission"]
        },
        "staffing": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/watch_demand" },
          "description": "Agent-class staffing requirements. Exclusive with staffing_by_duty_zone."
        },
        "staffing_by_duty_zone": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/watch_demand" },
          "description": "Duty-zone staffing for legacy binary platforms. Exclusive with staffing."
        },
        "required_zone_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_zone_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_systems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "capacity_model": {
          "type": "string",
          "enum": ["staffing_fraction", "bottleneck_min"],
          "default": "staffing_fraction"
        },
        "capacity_schedule": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 },
          "description": "Hour-of-day demand multipliers (0-23 keys)."
        },
        "feedback": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "cleaning_coverage_scale",
                "dining_weights",
                "zone_modifiers",
                "route_scalar_scale",
                "readout_only"
              ]
            },
            "enabled": { "type": "boolean", "default": true },
            "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "sustained_hours": { "type": "number", "exclusiveMinimum": 0 },
            "crew_sustenance": { "type": "boolean", "default": false },
            "zone_close_on_loss": {
              "type": "array",
              "items": { "type": "string" }
            },
            "scalar_name": {
              "type": "string",
              "enum": [
                "direct_contact_scalar",
                "droplet_scalar",
                "hvac_airborne_scalar",
                "fomite_scalar"
              ]
            },
            "floor": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "watch_demand": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required_on_watch": { "type": "integer", "minimum": 0 },
        "minimum_on_watch": { "type": "integer", "minimum": 0 },
        "symptomatic_effectiveness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "hazard_substance": {
      "type": "object",
      "required": ["substance_id", "parameters_provenance"],
      "additionalProperties": true,
      "properties": {
        "substance_id": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "transport": {
          "type": "string",
          "enum": ["armed", "none"],
          "default": "armed",
          "description": "Whether the zone pool rides the armed transport (native airflow network or CONTAM); 'none' keeps a standing field."
        },
        "environmental_contamination": {
          "type": "object",
          "additionalProperties": true,
          "description": "Reservoir-arm scalars (baseline_environmental_load, base_emission_rate_per_day, exposure_probability_per_day, spore_decay_rate_per_day, colonization_rate_per_day, source_zones). 'enabled' and 'person_to_person' are owned by the machinery and refused.",
          "properties": {
            "source_zones": { "type": "array", "items": { "type": "string" } },
            "baseline_environmental_load": { "type": "number", "minimum": 0 },
            "base_emission_rate_per_day": { "type": "number", "minimum": 0 },
            "exposure_probability_per_day": {
              "type": "number", "minimum": 0, "maximum": 1
            },
            "spore_decay_rate_per_day": { "type": "number", "minimum": 0 },
            "colonization_rate_per_day": { "type": "number" }
          }
        },
        "parameters_provenance": {
          "type": "string",
          "description": "Provenance note for every rate on the entry; NULL-SOURCE arms state it here."
        }
      }
    },
    "hazard_emitter": {
      "type": "object",
      "required": ["emitter_id", "substance_id", "kind", "zones", "rate"],
      "additionalProperties": true,
      "properties": {
        "emitter_id": { "type": "string" },
        "substance_id": {
          "type": "string",
          "description": "A declared hazard_sources substance_id or an existing pathogen profile id."
        },
        "enabled": { "type": "boolean", "default": true },
        "kind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["placement", "field"],
          "properties": {
            "placement": { "type": "string", "enum": ["point", "multipoint"] },
            "field": { "type": "string", "enum": ["standing", "dynamic"] }
          },
          "description": "kind is the placement x field pair: point = one zone; multipoint = the full declared rate replicated into every zone. standing = constant rate; dynamic = series or functional schedule recomputed per epoch."
        },
        "zones": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Zone ids on this platform; exactly one for placement 'point'."
        },
        "schedule": { "$ref": "#/$defs/hazard_schedule" },
        "rate": { "$ref": "#/$defs/hazard_rate" }
      }
    },
    "hazard_penetration": {
      "type": "object",
      "required": [
        "penetration_id", "substance_id", "adapter", "zones",
        "penetration_factor", "outdoor_field", "source", "grade"
      ],
      "additionalProperties": true,
      "properties": {
        "penetration_id": { "type": "string" },
        "substance_id": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "adapter": {
          "type": "string",
          "enum": ["uniform_outdoor"],
          "description": "Registered penetration adapter name; a QUIC or other CFD adapter registers under its own name at this seam (PENETRATION_ADAPTERS in engines/hazard_sources.py)."
        },
        "zones": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Penetration points as zone ids on this platform."
        },
        "penetration_factor": {
          "type": "number",
          "minimum": 0,
          "description": "Declared multiplier from outdoor concentration rate to indoor emission rate."
        },
        "outdoor_field": {
          "type": "object",
          "additionalProperties": true,
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "enum": ["uniform", "series"] },
            "concentration_per_hour": { "type": "number", "minimum": 0 },
            "series_per_hour": {
              "type": "array",
              "items": { "type": "number", "minimum": 0 },
              "minItems": 1
            }
          }
        },
        "schedule": { "$ref": "#/$defs/hazard_schedule" },
        "source": { "type": "string" },
        "grade": { "type": "string" }
      }
    },
    "hazard_schedule": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "start_epoch": {
          "type": "integer",
          "minimum": 0,
          "description": "First live epoch (introduction_epoch-style onset)."
        },
        "duration_hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Release window on a physical clock; the last covered epoch may be partial."
        }
      }
    },
    "hazard_rate": {
      "type": "object",
      "required": ["kind", "source", "grade"],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["constant", "series", "functional"],
          "description": "constant pairs with field 'standing'; series or functional pairs with 'dynamic'."
        },
        "mass_per_hour": {
          "type": "number",
          "minimum": 0,
          "description": "Constant, initial, or plateau rate in declared mass units per hour."
        },
        "series_per_hour": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 1,
          "description": "One per-hour rate per epoch from the schedule onset."
        },
        "functional_form": {
          "type": "string",
          "enum": ["exponential_decay", "linear_ramp"],
          "description": "Closed form integrated over each epoch; nothing compounds by hand."
        },
        "decay_rate_per_hour": {
          "type": "number",
          "minimum": 0,
          "description": "exponential_decay parameter."
        },
        "ramp_up_hours": {
          "type": "number",
          "minimum": 0,
          "description": "linear_ramp time to plateau."
        },
        "source": {
          "type": "string",
          "description": "Citation or 'NULL-SOURCE' for a declared arm."
        },
        "grade": { "type": "string" }
      }
    },
    "ship_system": {
      "type": "object",
      "required": ["system_id"],
      "additionalProperties": true,
      "properties": {
        "system_id": { "type": "string" },
        "health_start": { "type": "number", "minimum": 0, "maximum": 1 },
        "degradation": {
          "type": "object",
          "properties": {
            "rate_per_day": { "type": "number", "minimum": 0 },
            "model": { "type": "string", "enum": ["linear"] }
          }
        },
        "repair": {
          "type": "object",
          "properties": {
            "labor_class": { "type": "string" },
            "rate_per_person_hour": { "type": "number", "minimum": 0 }
          }
        },
        "failure_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "effects": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "capacity_multiplier_at_failure": { "type": "number" }
            }
          }
        },
        "repair_priority": { "type": "integer" }
      }
    },
    "medical_response": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-platform medical attentiveness knobs. isolation_compliance seeds fred_behavior.quarantine_compliance (FRED bimodal compliance unchanged).",
      "properties": {
        "sick_call_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Seeds syndromic.sick_call_probability when still at stock default."
        },
        "isolation_compliance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Seeds fred_behavior.quarantine_compliance when still at stock default."
        },
        "detection_delay_hours": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum wall-clock hours after symptom onset before sick-call Bernoulli is allowed. 0 = current behavior."
        },
        "crew_screening_interval_hours": {
          "description": "If set to a positive int, crew are proactively screened every N hours. null = off.",
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "notes": { "type": "string" }
      }
    },
    "meal_weights": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 },
      "properties": {
        "buffet": { "type": "number", "minimum": 0 },
        "mdr": { "type": "number", "minimum": 0 },
        "specialty": { "type": "number", "minimum": 0 },
        "crew_mess": { "type": "number", "minimum": 0 },
        "galley": { "type": "number", "minimum": 0 }
      }
    },
    "day_defaults": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "onboard_passenger_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "contact_rate_multiplier": { "type": "number", "minimum": 0 },
        "dining_demand_multiplier": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            {
              "type": "object",
              "additionalProperties": { "type": "number", "minimum": 0 },
              "properties": {
                "breakfast": { "type": "number", "minimum": 0 },
                "lunch": { "type": "number", "minimum": 0 },
                "dinner": { "type": "number", "minimum": 0 }
              }
            }
          ]
        },
        "embarkation_buffet_surge": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "itinerary_day": {
      "type": "object",
      "required": ["day", "type"],
      "additionalProperties": true,
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "type": {
          "type": "string",
          "enum": ["sea_day", "port_day", "embarkation", "disembarkation"]
        },
        "port": { "type": "string" },
        "port_id": {
          "type": "string",
          "description": "Stable port identifier (UN-LOCODE preferred, e.g. MXCZM). Sentinel analysis keys port hazards on this; falls back to a slug of `port` when absent."
        },
        "region": {
          "type": "string",
          "description": "WHO region or CDC quarantine station for regional hazard priors. Simulation-inert."
        },
        "calendar_date": {
          "type": "string",
          "format": "date",
          "description": "Real-world date of this voyage day (YYYY-MM-DD). Simulation-inert; used to key port-visit hazards across a fleet."
        },
        "crew_shore_leave_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of crew taking shore leave at this port call. Applied only when voyage.shore_exposure.enabled; default 0 (crew stay aboard)."
        },
        "embarkation_window_hours_of_day": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0 },
          "description": "Hour-of-day interval in which embarkation occurs."
        },
        "stateroom_available_epoch": { "type": "integer", "minimum": 0 },
        "buffet_surge_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "disembark_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "disembark_window_hours_of_day": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0 },
          "description": "Hour-of-day interval in which disembarkation occurs."
        },
        "reembark_window_hours_of_day": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0 },
          "description": "Hour-of-day interval in which reembarkation occurs."
        },
        "shore_infection_probability_per_hour": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Per-person-hour shore infection hazard for a person ashore at this port. Applied only when voyage.shore_exposure.enabled."
        },
        "shore_pathogen": {
          "type": "string",
          "description": "Pathogen id introduced ashore at this port. Defaults to the lowest-sorted configured pathogen id."
        },
        "notes": { "type": "string" }
      }
    }
  }
}
