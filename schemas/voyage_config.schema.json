{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crusher-to-the-bridge/schemas/voyage_config.schema.json",
  "title": "VoyageConfig",
  "description": "Cruise voyage itinerary, platform dining meal weights, and medical response knobs (ship operations layer).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string" },
    "platform_class": {
      "type": "string",
      "description": "Hull class of the platform this itinerary belongs to. The first four are the cruise platforms in data/platforms/; constitution and galaxy are the fictional Enterprise platforms (docs/paper3/variant_surveillance_spec.md §3). Consumed as an opaque grouping label (sentinel itinerary/line-list metadata), so adding a class does not change any behaviour keyed on the cruise four.",
      "enum": [
        "expedition",
        "classic",
        "spirit",
        "mega",
        "constitution",
        "galaxy"
      ]
    },
    "description": { "type": "string" },
    "voyage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "effects_enabled": {
          "type": "boolean",
          "default": false,
          "description": "When false (default), EpochState is identity sea-day; ashore/contact/dining/embarkation effects are not applied."
        },
        "total_epochs": { "type": "integer", "minimum": 1 },
        "embarkation_date": {
          "type": "string",
          "format": "date",
          "description": "Real-world date of voyage day 1 (YYYY-MM-DD). Simulation-inert; sentinel analysis derives per-day calendar dates from it."
        },
        "epoch_duration_hours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1,
          "description": "Physical duration of one epoch in hours. The natural-history clock converts day-valued pathogen parameters through this, so it must agree with any top-level epoch_duration_hours; a disagreement is refused rather than silently resolved."
        },
        "natural_history_clock": {
          "type": "string",
          "enum": ["hours", "legacy_epoch_day"],
          "default": "hours",
          "description": "hours (default): one epoch lasts epoch_duration_hours of physical time and day-valued pathogen parameters are converted. legacy_epoch_day: one epoch is one day of natural history regardless of the voyage grid, retained only as the historical control arm for paired sensitivity analysis."
        },
        "itinerary": {
          "type": "array",
          "items": { "$ref": "#/$defs/itinerary_day" }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "sea_day": { "$ref": "#/$defs/day_defaults" },
            "port_day": { "$ref": "#/$defs/day_defaults" },
            "embarkation": { "$ref": "#/$defs/day_defaults" },
            "disembarkation": { "$ref": "#/$defs/day_defaults" }
          }
        },
        "shore_exposure": {
          "type": "object",
          "additionalProperties": true,
          "description": "Port exposure gate, narrower than effects_enabled: crew shore leave and shore pathogen introduction. Both require this to be enabled.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "When false (default), crew stay aboard and shore_infection_probability_per_hour introduces nothing, so runs are bit-identical to pre-shore-exposure behavior."
            }
          }
        }
      }
    },
    "dining_meal_weights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "breakfast": { "$ref": "#/$defs/meal_weights" },
        "lunch": { "$ref": "#/$defs/meal_weights" },
        "dinner": { "$ref": "#/$defs/meal_weights" }
      }
    },
    "medical_response": { "$ref": "#/$defs/medical_response" },
    "ship_functions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Ship-function capacity declarations (docs/proposals/ship_function_capacity_spec.md §3): function instances keyed by (function_id, serves), scored each epoch from crew availability. enabled: false by default; absent = bit-identical.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "symptomatic_effectiveness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of a watch a symptomatic-but-present crew member delivers. Null-sourced declared arm; never anchor-fitted."
        },
        "functions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ship_function" }
        }
      }
    },
    "ship_systems": {
      "type": "array",
      "description": "Named ship systems with health state, degradation, and repair labor (spec §5).",
      "items": { "$ref": "#/$defs/ship_system" }
    }
  },
  "$defs": {
    "ship_function": {
      "type": "object",
      "required": ["function_id", "serves"],
      "additionalProperties": true,
      "properties": {
        "function_id": { "type": "string" },
        "serves": {
          "type": "string",
          "enum": ["passengers", "crew", "both", "mission"]
        },
        "staffing": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/watch_demand" },
          "description": "Agent-class staffing requirements. Exclusive with staffing_by_duty_zone."
        },
        "staffing_by_duty_zone": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/watch_demand" },
          "description": "Duty-zone staffing for legacy binary platforms. Exclusive with staffing."
        },
        "required_zone_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_zone_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_systems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "capacity_model": {
          "type": "string",
          "enum": ["staffing_fraction", "bottleneck_min"],
          "default": "staffing_fraction"
        },
        "capacity_schedule": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 },
          "description": "Hour-of-day demand multipliers (0-23 keys)."
        },
        "feedback": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "cleaning_coverage_scale",
                "dining_weights",
                "zone_modifiers",
                "route_scalar_scale",
                "readout_only"
              ]
            },
            "enabled": { "type": "boolean", "default": true },
            "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "sustained_hours": { "type": "number", "exclusiveMinimum": 0 },
            "crew_sustenance": { "type": "boolean", "default": false },
            "zone_close_on_loss": {
              "type": "array",
              "items": { "type": "string" }
            },
            "scalar_name": {
              "type": "string",
              "enum": [
                "direct_contact_scalar",
                "droplet_scalar",
                "hvac_airborne_scalar",
                "fomite_scalar"
              ]
            },
            "floor": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "watch_demand": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "required_on_watch": { "type": "integer", "minimum": 0 },
        "minimum_on_watch": { "type": "integer", "minimum": 0 },
        "symptomatic_effectiveness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "ship_system": {
      "type": "object",
      "required": ["system_id"],
      "additionalProperties": true,
      "properties": {
        "system_id": { "type": "string" },
        "health_start": { "type": "number", "minimum": 0, "maximum": 1 },
        "degradation": {
          "type": "object",
          "properties": {
            "rate_per_day": { "type": "number", "minimum": 0 },
            "model": { "type": "string", "enum": ["linear"] }
          }
        },
        "repair": {
          "type": "object",
          "properties": {
            "labor_class": { "type": "string" },
            "rate_per_person_hour": { "type": "number", "minimum": 0 }
          }
        },
        "failure_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "effects": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "capacity_multiplier_at_failure": { "type": "number" }
            }
          }
        },
        "repair_priority": { "type": "integer" }
      }
    },
    "medical_response": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-platform medical attentiveness knobs. isolation_compliance seeds fred_behavior.quarantine_compliance (FRED bimodal compliance unchanged).",
      "properties": {
        "sick_call_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Seeds syndromic.sick_call_probability when still at stock default."
        },
        "isolation_compliance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Seeds fred_behavior.quarantine_compliance when still at stock default."
        },
        "detection_delay_hours": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum wall-clock hours after symptom onset before sick-call Bernoulli is allowed. 0 = current behavior."
        },
        "crew_screening_interval_hours": {
          "description": "If set to a positive int, crew are proactively screened every N hours. null = off.",
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "notes": { "type": "string" }
      }
    },
    "meal_weights": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0 },
      "properties": {
        "buffet": { "type": "number", "minimum": 0 },
        "mdr": { "type": "number", "minimum": 0 },
        "specialty": { "type": "number", "minimum": 0 },
        "crew_mess": { "type": "number", "minimum": 0 },
        "galley": { "type": "number", "minimum": 0 }
      }
    },
    "day_defaults": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "onboard_passenger_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "contact_rate_multiplier": { "type": "number", "minimum": 0 },
        "dining_demand_multiplier": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            {
              "type": "object",
              "additionalProperties": { "type": "number", "minimum": 0 },
              "properties": {
                "breakfast": { "type": "number", "minimum": 0 },
                "lunch": { "type": "number", "minimum": 0 },
                "dinner": { "type": "number", "minimum": 0 }
              }
            }
          ]
        },
        "embarkation_buffet_surge": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "itinerary_day": {
      "type": "object",
      "required": ["day", "type"],
      "additionalProperties": true,
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "type": {
          "type": "string",
          "enum": ["sea_day", "port_day", "embarkation", "disembarkation"]
        },
        "port": { "type": "string" },
        "port_id": {
          "type": "string",
          "description": "Stable port identifier (UN-LOCODE preferred, e.g. MXCZM). Sentinel analysis keys port hazards on this; falls back to a slug of `port` when absent."
        },
        "region": {
          "type": "string",
          "description": "WHO region or CDC quarantine station for regional hazard priors. Simulation-inert."
        },
        "calendar_date": {
          "type": "string",
          "format": "date",
          "description": "Real-world date of this voyage day (YYYY-MM-DD). Simulation-inert; used to key port-visit hazards across a fleet."
        },
        "crew_shore_leave_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of crew taking shore leave at this port call. Applied only when voyage.shore_exposure.enabled; default 0 (crew stay aboard)."
        },
        "embarkation_window_hours_of_day": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0 },
          "description": "Hour-of-day interval in which embarkation occurs."
        },
        "stateroom_available_epoch": { "type": "integer", "minimum": 0 },
        "buffet_surge_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "disembark_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "disembark_window_hours_of_day": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0 },
          "description": "Hour-of-day interval in which disembarkation occurs."
        },
        "reembark_window_hours_of_day": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 0 },
          "description": "Hour-of-day interval in which reembarkation occurs."
        },
        "shore_infection_probability_per_hour": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Per-person-hour shore infection hazard for a person ashore at this port. Applied only when voyage.shore_exposure.enabled."
        },
        "shore_pathogen": {
          "type": "string",
          "description": "Pathogen id introduced ashore at this port. Defaults to the lowest-sorted configured pathogen id."
        },
        "notes": { "type": "string" }
      }
    }
  }
}
