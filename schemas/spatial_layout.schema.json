{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial_layout.schema.json",
  "title": "Spatial Layout",
  "description": "Room/zone node definitions with display coordinates for the Crusher-to-the-Bridge spatial deck map.",
  "type": "object",
  "required": ["platform", "zones"],
  "properties": {
    "platform": {"type": "string"},
    "description": {"type": "string"},
    "deck_dimensions": {
      "type": "object",
      "properties": {
        "length_m": {"type": "number", "minimum": 0},
        "beam_m": {"type": "number", "minimum": 0}
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Zone"
      }
    }
  },
  "$defs": {
    "Zone": {
      "type": "object",
      "required": ["id", "type", "volume_m3", "display"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique zone name (no spaces — use underscores)"
        },
        "type": {
          "type": "string",
          "enum": ["Free", "Dining", "Room", "Medical", "Engineering"]
        },
        "traffic": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "volume_m3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Room volume in cubic meters"
        },
        "deck": {
          "type": "string",
          "enum": ["upper", "main", "lower"]
        },
        "display": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"}
          }
        },
        "description": {"type": "string"},
        "base_ach": {
          "type": "number",
          "minimum": 0,
          "description": "Base air changes per hour (optional override)"
        }
      }
    }
  }
}
