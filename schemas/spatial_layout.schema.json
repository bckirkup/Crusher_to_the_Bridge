{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial_layout.schema.json",
  "title": "Spatial Layout",
  "description": "Room/zone node definitions with display coordinates for the Crusher-to-the-Bridge spatial deck map.",
  "type": "object",
  "required": ["platform", "zones"],
  "properties": {
    "platform": {"type": "string"},
    "description": {"type": "string"},
    "deck_dimensions": {
      "type": "object",
      "properties": {
        "length_m": {"type": "number", "minimum": 0},
        "beam_m": {"type": "number", "minimum": 0}
      }
    },
    "confinement_isolation_factor": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "description": "Direct-contact/droplet multiplier for quarantined agents in cabin corridors"
    },
    "corridor_direct_contact_factor": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "description": "Base direct-contact multiplier for Cabin_Corridor zones (hallway vs ward)"
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Zone"
      }
    }
  },
  "$defs": {
    "Zone": {
      "type": "object",
      "required": ["id", "type", "volume_m3", "display"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique zone name (no spaces — use underscores)"
        },
        "type": {
          "type": "string",
          "enum": ["Free", "Dining", "Room", "Medical", "Engineering", "Cabin_Corridor"]
        },
        "traffic": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "volume_m3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Room volume in cubic meters"
        },
        "deck": {
          "type": "string",
          "description": "Deck or level identifier (platform-specific, e.g. main, saucer_10, 3_Marina)"
        },
        "display": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"}
          }
        },
        "description": {"type": "string"},
        "base_ach": {
          "type": "number",
          "minimum": 0,
          "description": "Base air changes per hour (optional override)"
        },
        "max_occupancy": {
          "type": "integer",
          "minimum": 1,
          "description": "Nominal max occupants for the zone (simulation / display)"
        },
        "cabin_ventilation_type": {
          "type": "string",
          "enum": ["interior_hvac", "balcony_partial", "atrium_view"],
          "description": "Cabin corridor ventilation class (balcony_partial reduces aerosol dose)"
        }
      }
    }
  }
}
