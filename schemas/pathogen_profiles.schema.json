{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pathogen_profiles.schema.json",
  "title": "Pathogen Profiles",
  "description": "Multi-pathogen profile definitions for concurrent simulation in Crusher-to-the-Bridge.",
  "type": "object",
  "required": ["pathogens"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "description": {"type": "string"},
        "version": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "pathogens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/PathogenProfile"
      }
    }
  },
  "$defs": {
    "EffectRange": {
      "type": "array",
      "description": "[lo, hi] bounds a phenotype mutation's effect is drawn from.",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2
    },
    "StrainEvolution": {
      "type": "object",
      "description": "Optional heritable-strain parameters (variant surveillance, Paper 3). Absent block = no strain structure for this pathogen.",
      "required": ["genotypes"],
      "properties": {
        "mutation_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Probability of a point mutation per transmission event."
        },
        "phenotype_mutation_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of mutations that alter phenotype rather than only the neutral label."
        },
        "within_host_mutation_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Probability of a point mutation per infected-agent-epoch. Default 0 keeps the transmission-only model as the baseline."
        },
        "recombination_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Probability of a recombination event per co-infected agent-epoch."
        },
        "superinfection_susceptibility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Relative susceptibility of an already-infected host to a second strain of the same pathogen (0 = complete homotypic interference)."
        },
        "genotypes": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "description": "Genotype labels (e.g. GII.4, GII.17)."
        },
        "prior_genotype_distribution": {
          "type": "object",
          "description": "Weights over genotypes for pre-existing immunity in baseline immune agents. Renormalized on load; keys must be declared genotypes.",
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "cross_immunity": {
          "type": "object",
          "description": "Matrix [prior_genotype][challenge_genotype] = protection in [0,1]. Keys must be declared genotypes.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "effect_ranges": {
          "type": "object",
          "description": "Ranges phenotype mutation effects are drawn from.",
          "properties": {
            "transmissibility": {"$ref": "#/$defs/EffectRange"},
            "shedding": {"$ref": "#/$defs/EffectRange"},
            "incubation_days": {"$ref": "#/$defs/EffectRange"},
            "immune_escape": {"$ref": "#/$defs/EffectRange"}
          },
          "additionalProperties": false
        },
        "min_strain_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Frequency floor below which strains are lumped into an unresolved bin, bounding state growth."
        },
        "notes": {
          "type": "string",
          "description": "Provenance for these rates: literature anchor, or the fact that a value is a placeholder pending one."
        }
      },
      "additionalProperties": false
    },
    "SequencingAssay": {
      "type": "object",
      "description": "Optional clinical amplicon typing assay (variant surveillance, Paper 3, spec §2.1). Absent block = this pathogen is not typed clinically. Read depth and the reporting floor are operator dials set at run time, not pathogen properties.",
      "required": ["amplicon_target", "read_accuracy", "ct_threshold"],
      "properties": {
        "amplicon_target": {
          "type": "string",
          "minLength": 1,
          "description": "Sequenced region (e.g. 'Capsid (VP1)', 'HA + NA')."
        },
        "read_accuracy": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Probability a read is assigned to the lineage it came from. Below 1 the assay can name the wrong genotype, not merely fail."
        },
        "ct_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Ct above which the specimen cannot be typed (shares the targeted-PCR standard curve)."
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Per-specimen financial cost; overrides the ledger default for clinical_strain_typing."
        },
        "read_depth": {
          "type": "integer",
          "minimum": 1,
          "description": "Default reads per specimen for this assay; sweepable at run time."
        },
        "min_reads_for_genotype": {
          "type": "integer",
          "minimum": 1,
          "description": "Reads a genotype must clear to be reported, which sets the mixture resolution."
        },
        "notes": {
          "type": "string",
          "description": "Provenance for these assay values."
        }
      },
      "additionalProperties": false
    },
    "PathogenProfile": {
      "type": "object",
      "required": ["pathogen_id", "name", "transmission_routes"],
      "properties": {
        "pathogen_id": {
          "type": "string",
          "description": "Unique identifier (e.g. 'norwalk_gi', 'sars_cov2_resp')"
        },
        "name": {"type": "string"},
        "category": {
          "type": "string",
          "enum": ["enteric_viral", "respiratory_viral", "bacterial", "fungal", "bacterial_waterborne", "enteric_bacterial", "filovirus"]
        },
        "transmission_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["direct_contact", "fomite", "droplet", "hvac_airborne", "water_aerosol", "food", "water", "bodily_fluids"]
          },
          "minItems": 1
        },
        "shedding_curve_log10": {
          "type": "array",
          "items": {"type": "number", "minimum": 0},
          "description": "Day-by-day symptomatic shedding rate (log10 copies)"
        },
        "asymptomatic_shedding_log10": {
          "type": "array",
          "items": {"type": "number", "minimum": 0}
        },
        "dose_adjustment": {
          "type": "number",
          "minimum": 0,
          "description": "Log10 shedding offset: shedding = 10^(curve[dpi] - dose_adjustment) * shedding_multiplier. Campaigns calibrate infectivity via pathogen_overrides; not a dose-response α/β scaler."
        },
        "shedding_variance_log10": {
          "type": "number",
          "minimum": 0,
          "description": "σ of log-normal host shedding multiplier (0 = no variance)"
        },
        "transmission_route_weights": {
          "type": "object",
          "description": "Relative pathway dose multipliers (typically sum to 1.0). Absent → all 1.0 (identity). Keys map to TransmissionCore pathways.",
          "properties": {
            "direct_contact": {"type": "number", "minimum": 0},
            "droplet": {"type": "number", "minimum": 0},
            "hvac_airborne": {"type": "number", "minimum": 0},
            "fomite": {"type": "number", "minimum": 0},
            "food_contamination": {"type": "number", "minimum": 0},
            "environmental_source": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "innate_nonsusceptible_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of agents with zero susceptibility to this pathogen (e.g. FUT2 non-secretors for norovirus). Orthogonal to ship_graph.immune_fraction."
        },
        "nonsusceptible_mechanism": {
          "type": "string",
          "description": "Label for innate nonsusceptibility biology (e.g. FUT2_nonsecretor, none)."
        },
        "dose_response": {
          "type": "object",
          "required": ["model"],
          "properties": {
            "model": {"type": "string", "enum": ["beta_poisson", "exponential"]},
            "alpha": {"type": "number", "exclusiveMinimum": 0},
            "beta": {"type": "number", "exclusiveMinimum": 0},
            "k": {"type": "number", "exclusiveMinimum": 0, "description": "Rate parameter for exponential model"}
          },
          "if": {"properties": {"model": {"const": "beta_poisson"}}},
          "then": {"required": ["alpha", "beta"]},
          "else": {
            "if": {"properties": {"model": {"const": "exponential"}}},
            "then": {"required": ["k"]}
          }
        },
        "illness_probability": {
          "type": "object",
          "properties": {
            "eta": {"type": "number", "minimum": 0, "maximum": 1},
            "gamma": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "recovery_day": {"type": "integer", "minimum": 0},
        "symptom_onset_day": {"type": "number", "minimum": 0},
        "surface_deposition_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "base_susceptibility": {"type": "number", "minimum": 0},
        "microflora_disruption": {
          "type": "object",
          "properties": {
            "causes_disruption": {"type": "boolean"},
            "disruption_type": {
              "type": "string",
              "enum": [
                "gastrointestinal",
                "respiratory",
                "dermal",
                "immune_memory_and_respiratory",
                "gastrointestinal_spore_antibiotic_associated",
                "systemic",
                "systemic_fever",
                "systemic_respiratory",
                "systemic_gastrointestinal"
              ]
            },
            "disruption_magnitude": {"type": "number", "minimum": 0, "maximum": 1},
            "affected_kingdoms": {
              "type": "object",
              "properties": {
                "Bacteria": {"type": "object", "additionalProperties": {"type": "number"}},
                "Archaea": {"type": "object", "additionalProperties": {"type": "number"}},
                "Fungi": {"type": "object", "additionalProperties": {"type": "number"}},
                "Virus": {"type": "object", "additionalProperties": {"type": "number"}}
              }
            }
          }
        },
        "introduction_epoch": {"type": "integer", "minimum": 0},
        "initial_infected": {"type": "integer", "minimum": 0},
        "initial_time_infected": {
          "type": "integer",
          "minimum": 0,
          "description": "Days post-infection when seeding initial_infected agents at introduction_epoch. Transmission-acquired infections always start at 0."
        },
        "strain_evolution": {
          "$ref": "#/$defs/StrainEvolution"
        },
        "sequencing_assay": {
          "$ref": "#/$defs/SequencingAssay"
        },
        "clinical_presentation": {
          "type": "object",
          "description": "Bedside syndrome and time-dependent feature phases for diagnostic routing.",
          "properties": {
            "syndromes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "gastrointestinal",
                  "respiratory",
                  "systemic_febrile",
                  "rash",
                  "wound_soft_tissue",
                  "neurologic"
                ]
              },
              "minItems": 1
            },
            "sample_types": {
              "type": "array",
              "items": {"type": "string"}
            },
            "phases": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "dpi_min", "features"],
                "properties": {
                  "name": {"type": "string"},
                  "dpi_min": {"type": "integer", "minimum": 0},
                  "dpi_max": {"type": ["integer", "null"], "minimum": 0},
                  "features": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "syndromes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "gastrointestinal",
                        "respiratory",
                        "systemic_febrile",
                        "rash",
                        "wound_soft_tissue",
                        "neurologic"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
