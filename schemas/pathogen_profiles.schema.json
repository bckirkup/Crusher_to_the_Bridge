{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pathogen_profiles.schema.json",
  "title": "Pathogen Profiles",
  "description": "Multi-pathogen profile definitions for concurrent simulation in Crusher-to-the-Bridge.",
  "type": "object",
  "required": ["pathogens"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "description": {"type": "string"},
        "version": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "pathogens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/PathogenProfile"
      }
    }
  },
  "$defs": {
    "PathogenProfile": {
      "type": "object",
      "required": ["pathogen_id", "name", "transmission_routes"],
      "properties": {
        "pathogen_id": {
          "type": "string",
          "description": "Unique identifier (e.g. 'norwalk_gi', 'sars_cov2_resp')"
        },
        "name": {"type": "string"},
        "category": {
          "type": "string",
          "enum": ["enteric_viral", "respiratory_viral", "bacterial", "fungal", "bacterial_waterborne", "enteric_bacterial", "filovirus"]
        },
        "transmission_routes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["direct_contact", "fomite", "droplet", "hvac_airborne", "water_aerosol", "food", "water", "bodily_fluids"]
          },
          "minItems": 1
        },
        "shedding_curve_log10": {
          "type": "array",
          "items": {"type": "number", "minimum": 0},
          "description": "Day-by-day symptomatic shedding rate (log10 copies)"
        },
        "asymptomatic_shedding_log10": {
          "type": "array",
          "items": {"type": "number", "minimum": 0}
        },
        "dose_adjustment": {
          "type": "number",
          "minimum": 0,
          "description": "Log10 shedding offset: shedding = 10^(curve[dpi] - dose_adjustment) * shedding_multiplier. Campaigns calibrate infectivity via pathogen_overrides; not a dose-response α/β scaler."
        },
        "shedding_variance_log10": {
          "type": "number",
          "minimum": 0,
          "description": "σ of log-normal host shedding multiplier (0 = no variance)"
        },
        "transmission_route_weights": {
          "type": "object",
          "description": "Relative pathway dose multipliers (typically sum to 1.0). Absent → all 1.0 (identity). Keys map to TransmissionCore pathways.",
          "properties": {
            "direct_contact": {"type": "number", "minimum": 0},
            "droplet": {"type": "number", "minimum": 0},
            "hvac_airborne": {"type": "number", "minimum": 0},
            "fomite": {"type": "number", "minimum": 0},
            "food_contamination": {"type": "number", "minimum": 0},
            "environmental_source": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "innate_nonsusceptible_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of agents with zero susceptibility to this pathogen (e.g. FUT2 non-secretors for norovirus). Orthogonal to ship_graph.immune_fraction."
        },
        "nonsusceptible_mechanism": {
          "type": "string",
          "description": "Label for innate nonsusceptibility biology (e.g. FUT2_nonsecretor, none)."
        },
        "dose_response": {
          "type": "object",
          "required": ["model"],
          "properties": {
            "model": {"type": "string", "enum": ["beta_poisson", "exponential"]},
            "alpha": {"type": "number", "exclusiveMinimum": 0},
            "beta": {"type": "number", "exclusiveMinimum": 0},
            "k": {"type": "number", "exclusiveMinimum": 0, "description": "Rate parameter for exponential model"}
          },
          "if": {"properties": {"model": {"const": "beta_poisson"}}},
          "then": {"required": ["alpha", "beta"]},
          "else": {
            "if": {"properties": {"model": {"const": "exponential"}}},
            "then": {"required": ["k"]}
          }
        },
        "illness_probability": {
          "type": "object",
          "properties": {
            "eta": {"type": "number", "minimum": 0, "maximum": 1},
            "gamma": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "recovery_day": {"type": "integer", "minimum": 0},
        "surface_deposition_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "base_susceptibility": {"type": "number", "minimum": 0},
        "microflora_disruption": {
          "type": "object",
          "properties": {
            "causes_disruption": {"type": "boolean"},
            "disruption_type": {
              "type": "string",
              "enum": [
                "gastrointestinal",
                "respiratory",
                "dermal",
                "immune_memory_and_respiratory",
                "gastrointestinal_spore_antibiotic_associated",
                "systemic",
                "systemic_fever",
                "systemic_respiratory",
                "systemic_gastrointestinal"
              ]
            },
            "disruption_magnitude": {"type": "number", "minimum": 0, "maximum": 1},
            "affected_kingdoms": {
              "type": "object",
              "properties": {
                "Bacteria": {"type": "object", "additionalProperties": {"type": "number"}},
                "Archaea": {"type": "object", "additionalProperties": {"type": "number"}},
                "Fungi": {"type": "object", "additionalProperties": {"type": "number"}},
                "Virus": {"type": "object", "additionalProperties": {"type": "number"}}
              }
            }
          }
        },
        "introduction_epoch": {"type": "integer", "minimum": 0},
        "initial_infected": {"type": "integer", "minimum": 0},
        "initial_time_infected": {
          "type": "integer",
          "minimum": 0,
          "description": "Days post-infection when seeding initial_infected agents at introduction_epoch. Transmission-acquired infections always start at 0."
        },
        "clinical_presentation": {
          "type": "object",
          "description": "Bedside syndrome and time-dependent feature phases for diagnostic routing.",
          "properties": {
            "syndromes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "gastrointestinal",
                  "respiratory",
                  "systemic_febrile",
                  "rash",
                  "wound_soft_tissue",
                  "neurologic"
                ]
              },
              "minItems": 1
            },
            "sample_types": {
              "type": "array",
              "items": {"type": "string"}
            },
            "phases": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "dpi_min", "features"],
                "properties": {
                  "name": {"type": "string"},
                  "dpi_min": {"type": "integer", "minimum": 0},
                  "dpi_max": {"type": ["integer", "null"], "minimum": 0},
                  "features": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "syndromes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "gastrointestinal",
                        "respiratory",
                        "systemic_febrile",
                        "rash",
                        "wound_soft_tissue",
                        "neurologic"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
