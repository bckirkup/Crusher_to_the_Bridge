{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource_costs.schema.json",
  "title": "Resource Costs",
  "description": "Budget, material inventory, and per-test cost definitions for the Cost-Accounting Ledger.",
  "type": "object",
  "properties": {
    "description": {"type": "string"},
    "budgets": {
      "type": "object",
      "properties": {
        "financial_usd": {
          "type": "object",
          "properties": {
            "starting_balance": {"type": "number", "minimum": 0},
            "description": {"type": "string"}
          }
        },
        "labor_person_hours": {
          "type": "object",
          "properties": {
            "starting_capacity": {"type": "number", "minimum": 0},
            "description": {"type": "string"}
          }
        }
      }
    },
    "contribution_media": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ContributionMedium"
      }
    },
    "material_inventory": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/MaterialItem"
      }
    },
    "baseline_surveillance_costs_per_epoch": {
      "type": "object",
      "properties": {
        "financial_usd": {"type": "number", "minimum": 0},
        "labor_person_hours": {"type": "number", "minimum": 0},
        "materials": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "per_test_costs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PerTestCost"
      }
    },
    "operational_impact_weights": {
      "$ref": "#/$defs/OperationalImpactWeights"
    }
  },
  "$defs": {
    "OperationalImpactWeights": {
      "type": "object",
      "description": "Per-unit OIS weights for confinement, zone closures, and fleet PPE (tracker only).",
      "properties": {
        "per_passenger_quarantined": {"type": "number", "minimum": 0},
        "per_essential_crew_quarantined": {"type": "number", "minimum": 0},
        "per_passenger_isolated": {"type": "number", "minimum": 0},
        "per_closed_galley_zone": {"type": "number", "minimum": 0},
        "per_fleet_ppe_active": {"type": "number", "minimum": 0},
        "essential_crew_classes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "galley_zone_types": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "MaterialItem": {
      "type": "object",
      "properties": {
        "starting_count": {"type": "integer", "minimum": 0},
        "unit_cost_usd": {"type": "number", "minimum": 0},
        "description": {"type": "string"}
      }
    },
    "PerTestCost": {
      "type": "object",
      "properties": {
        "financial_usd": {"type": "number", "minimum": 0},
        "labor_person_hours": {"type": "number", "minimum": 0},
        "materials": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "ContributionMedium": {
      "type": "object",
      "required": [
        "conversion_rate_usd_per_unit",
        "conversion_rate_sweep",
        "description"
      ],
      "properties": {
        "conversion_rate_usd_per_unit": {
          "type": "number",
          "minimum": 0
        },
        "conversion_rate_sweep": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
