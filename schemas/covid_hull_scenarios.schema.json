{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "covid_hull_scenarios.schema.json",
  "title": "COVID Hull Scenarios",
  "description": "The replayed SARS-CoV-2 hull events of the COVID arm: event geometry (duration, population, passenger/crew structure, quarantine calendar, testing-campaign alignment) plus the fixed train/test split. No biological constant belongs here; both hulls read the shared pathogen profile.",
  "type": "object",
  "required": ["schema_version", "split", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "description": {"type": "string"},
    "split": {
      "type": "object",
      "required": ["fixed_by", "fixed_before_implementation", "training", "held_out"],
      "additionalProperties": false,
      "properties": {
        "fixed_by": {"type": "string", "minLength": 1},
        "fixed_before_implementation": {"const": true},
        "training": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "minLength": 1},
          "description": "Exactly one training hull: the arm fits one composite quantity on one event."
        },
        "held_out": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "held_out_aggregates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "note": {"type": "string"}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Scenario"}
    }
  },
  "$defs": {
    "Scenario": {
      "type": "object",
      "required": [
        "scenario_id", "hull_name", "split_role", "pathogen_id", "platform_id",
        "clock", "duration_days", "population", "role_classes", "initiation",
        "scheduled_protocols", "testing_campaign", "provenance", "refusals"
      ],
      "additionalProperties": false,
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "hull_name": {"type": "string", "minLength": 1},
        "event": {"type": "string"},
        "split_role": {"type": "string", "enum": ["training", "held_out"]},
        "pathogen_id": {"type": "string", "minLength": 1},
        "platform_id": {"type": "string", "minLength": 1},
        "agent_profile_bundle": {
          "type": ["string", "null"],
          "description": "Repository-relative agent profile bundle carrying the hull's age composition, or null where no age table is published and the default bundle stands."
        },
        "clock": {
          "type": "object",
          "required": ["epoch_duration_hours", "natural_history_clock"],
          "additionalProperties": false,
          "properties": {
            "epoch_duration_hours": {"type": "number", "exclusiveMinimum": 0},
            "natural_history_clock": {"type": "string", "enum": ["hours", "legacy_epoch_day"]}
          }
        },
        "duration_days": {"type": "integer", "minimum": 1},
        "day_zero": {"type": "string"},
        "population": {
          "type": "object",
          "required": ["total", "passengers", "crew"],
          "additionalProperties": false,
          "properties": {
            "total": {"type": "integer", "minimum": 1},
            "passengers": {"type": "integer", "minimum": 0},
            "crew": {"type": "integer", "minimum": 0}
          }
        },
        "role_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["class_id", "role_group", "count"],
            "additionalProperties": false,
            "properties": {
              "class_id": {"type": "string", "minLength": 1},
              "role_group": {"type": "string", "enum": ["passenger", "crew"]},
              "count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "initiation": {
          "type": "object",
          "required": ["explicit_seeds"],
          "additionalProperties": false,
          "properties": {
            "explicit_seeds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["pathogen", "count", "epoch", "infection_age_days"],
                "additionalProperties": false,
                "properties": {
                  "pathogen": {"type": "string", "minLength": 1},
                  "count": {"type": "integer", "minimum": 1},
                  "role": {"type": ["string", "null"], "enum": ["passenger", "crew", null]},
                  "epoch": {"type": "integer", "minimum": 0},
                  "infection_age_days": {"type": "number", "minimum": 0}
                }
              }
            }
          }
        },
        "scheduled_protocols": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["protocol_id", "start_day"],
            "additionalProperties": false,
            "properties": {
              "protocol_id": {"type": "string", "pattern": "^SOP-[0-9]{3}$"},
              "start_day": {"type": "integer", "minimum": 0},
              "end_day": {"type": ["integer", "null"], "minimum": 0},
              "calendar": {"type": "string"}
            }
          }
        },
        "testing_campaign": {
          "type": "object",
          "required": ["campaign_id", "start_day"],
          "additionalProperties": false,
          "properties": {
            "campaign_id": {"type": "string", "minLength": 1},
            "start_day": {"type": "integer", "minimum": 0},
            "calendar": {"type": "string"}
          }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field", "value", "source", "grade"],
            "additionalProperties": false,
            "properties": {
              "field": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "grade": {"type": "string", "enum": ["A", "B", "C", "declared", "null"]},
              "note": {"type": "string"}
            }
          }
        },
        "refusals": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
