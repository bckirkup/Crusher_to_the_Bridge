{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crusher-to-the-bridge/schemas/decision_action.schema.json",
  "title": "DecisionAction",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "noop",
        "set_surveillance_cadence",
        "set_isolation_posture",
        "authorize_sop_subset",
        "directive_to_medical",
        "corporate_communication_stance",
        "issue_crew_instruction",
        "recommend_sop",
        "request_sop_activation",
        "set_surveillance_budget_emphasis",
        "activate_sop",
        "deactivate_sop",
        "order_verification_test",
        "hide_symptoms",
        "report_sick_call",
        "refuse_quarantine"
      ]
    },
    "pcr_cadence": { "type": "integer", "minimum": 1 },
    "sequencing_cadence": { "type": "integer", "minimum": 1 },
    "protocol_ids": { "type": "array", "items": { "type": "string" } },
    "protocol_id": { "type": "string" },
    "stance": { "type": "number", "minimum": 0, "maximum": 1 },
    "message": { "type": "string" },
    "directive": { "type": "object" },
    "threshold_scale": { "type": "number", "minimum": 0, "maximum": 2 },
    "sop_id": { "type": "string" },
    "zone": { "type": "string" },
    "agent_id": { "type": "integer", "minimum": 0 },
    "emphasis": { "type": "string" }
  }
}
