{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crusher-to-the-bridge/schemas/preboarding_decision_summary.schema.json",
  "title": "PreboardingDecisionSummary",
  "description": "Aggregated Monte Carlo outcomes for one pre-boarding decision scenario.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "scenario_id",
    "policy",
    "n_mc",
    "expected_intercepted",
    "expected_K_board",
    "expected_P_trigger",
    "expected_attack_rate",
    "expected_total_cost"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "scenario_id": { "type": "string" },
    "policy": { "type": "string" },
    "platform_class": { "type": "string" },
    "pathogen": { "type": "string" },
    "pi_inf": { "type": "number" },
    "n_mc": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "expected_intercepted": { "type": "number", "minimum": 0 },
    "expected_K_intro": { "type": "number", "minimum": 0 },
    "expected_K_board": { "type": "number", "minimum": 0 },
    "expected_P_trigger": { "type": "number", "minimum": 0, "maximum": 1 },
    "expected_P_accel": { "type": "number", "minimum": 0, "maximum": 1 },
    "expected_attack_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "expected_total_cost": { "type": "number" },
    "expected_screening_cost": { "type": "number" },
    "expected_false_positive_cost": { "type": "number" },
    "expected_true_positive_cost": { "type": "number" },
    "expected_onboard_cost": { "type": "number" },
    "expected_reputational_cost": { "type": "number" },
    "false_positives_per_true_positive": { "type": ["number", "null"] },
    "false_positives_per_vsp_avoided": { "type": ["number", "null"] },
    "cost_per_vsp_avoided": { "type": ["number", "null"] },
    "break_even_prevalence": { "type": ["number", "null"] },
    "value_of_information_per_pax": { "type": ["number", "null"] },
    "parameters": { "type": "object" }
  }
}
