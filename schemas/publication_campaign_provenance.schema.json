{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication campaign provenance envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_uid",
    "paper_id",
    "run_intent",
    "source",
    "environment",
    "inputs",
    "effective_config_sha256",
    "seed_policy",
    "lineage",
    "created_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "campaign_uid": {
      "type": "string",
      "format": "uuid"
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "run_intent": {
      "enum": [
        "exploratory",
        "confirmatory",
        "revision",
        "review_response",
        "qualification"
      ]
    },
    "analysis_plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_response_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "tree_sha256",
        "dirty"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_sha256",
        "platform",
        "python",
        "container_digest"
      ],
      "properties": {
        "lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "container_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "effective_config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "seed_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "seeds_sha256"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "seeds_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_campaign_uid",
        "supersedes"
      ],
      "properties": {
        "parent_campaign_uid": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "run_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_intent": {
            "enum": [
              "confirmatory",
              "revision"
            ]
          }
        }
      },
      "then": {
        "required": [
          "analysis_plan_id"
        ],
        "properties": {
          "analysis_plan_id": {
            "type": "string",
            "minLength": 1
          },
          "lineage": {
            "properties": {
              "parent_campaign_uid": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_intent": {
            "const": "review_response"
          }
        }
      },
      "then": {
        "required": [
          "analysis_plan_id",
          "review_response_id"
        ],
        "properties": {
          "analysis_plan_id": {
            "type": "string",
            "minLength": 1
          },
          "review_response_id": {
            "type": "string",
            "minLength": 1
          },
          "lineage": {
            "properties": {
              "parent_campaign_uid": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  ]
}
