{
  "schema_version": "1.0",
  "platform_class": "expedition",
  "description": "Greg Mortimer voyage defaults. effects_enabled=false keeps campaigns identical to pre-voyage baseline.",
  "voyage": {
    "effects_enabled": false,
    "total_epochs": 168,
    "epoch_duration_hours": 1,
    "itinerary": [],
    "defaults": {
      "sea_day": {
        "onboard_passenger_fraction": 1.0,
        "contact_rate_multiplier": 1.0,
        "dining_demand_multiplier": 1.0
      },
      "port_day": {
        "onboard_passenger_fraction": 0.3,
        "contact_rate_multiplier": 0.4,
        "dining_demand_multiplier": {
          "breakfast": 0.8,
          "lunch": 0.3,
          "dinner": 0.9
        }
      },
      "embarkation": {
        "onboard_passenger_fraction": 1.0,
        "embarkation_buffet_surge": true,
        "contact_rate_multiplier": 1.2
      },
      "disembarkation": {
        "onboard_passenger_fraction": 0.0,
        "contact_rate_multiplier": 0.2,
        "dining_demand_multiplier": {
          "breakfast": 0.5,
          "lunch": 0.1,
          "dinner": 0.1
        }
      }
    }
  },
  "dining_meal_weights": {
    "breakfast": {
      "buffet": 0.85,
      "mdr": 0.0,
      "specialty": 0.0,
      "crew_mess": 0.15
    },
    "lunch": {
      "buffet": 0.75,
      "mdr": 0.0,
      "specialty": 0.1,
      "crew_mess": 0.15
    },
    "dinner": {
      "buffet": 0.55,
      "mdr": 0.0,
      "specialty": 0.15,
      "crew_mess": 0.1
    }
  },
  "medical_response": {
    "sick_call_probability": 0.7,
    "isolation_compliance": 0.85,
    "detection_delay_hours": 0,
    "crew_screening_interval_hours": null,
    "notes": "Stock defaults (= current global behavior). Class gradient available via campaign overrides."
  }
}
