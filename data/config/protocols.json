    {
      "protocol_id": "SOP-009",
      "name": "General Confinement to Quarters",
      "description": "Full ship-wide quarantine to quarters (lockdown). All non-essential personnel confined to home zones; only watchstanders and medical crew exempt. Quarantined agents remain HVAC-connected. Severe reduction in direct contact, droplet, and fomite transmission.",
