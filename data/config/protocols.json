{
  "description": "Standing Operating Protocols (SOPs) for the Reactive Protocol Engine. Each protocol maps a LOW_FIDELITY stoplight trigger condition from a specific instrument class to physics/behavior modifiers and resource costs.",
  "protocols": [
    {
      "protocol_id": "SOP-001",
      "name": "Enhanced Ventilation",
      "description": "Upgrade HVAC filtration when airborne anomaly is detected.",
      "trigger": {
        "instrument_class": "continuous_air_sampler",
        "stoplight_level": "AMBER",
        "min_zones_affected": 1
      },
      "modifiers": {
        "hvac_filter_efficiency_override": 0.80,
        "hvac_filter_type_label": "MERV-16"
      },
      "costs_per_epoch": {
        "financial_usd": 150.00,
        "materials": {
          "hvac_filters": 0
        },
        "labor_person_hours": 1.0
      },
      "activation_costs": {
        "financial_usd": 500.00,
        "materials": {
          "hvac_filters": 2
        },
        "labor_person_hours": 4.0
      },
      "category": "intervention",
      "required_cascade_tier": null
    },
