      "modifiers": {
        "confine_all_to_quarters": true,
        "exempt_classes": ["crew_medical", "crew_engineering"],
        "direct_contact_scalar": 0.10,
        "droplet_scalar": 0.10,
        "fomite_scalar": 0.20,
        "hvac_airborne_scalar": 0.70,
        "close_zones": ["Galley", "Mess_Hall"]
