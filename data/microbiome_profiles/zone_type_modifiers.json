{
  "_meta": {
    "name": "zone_type_modifiers",
    "description": "Shipboard built-environment room-type modifiers for coastal_port_profile.json and open_ocean_profile.json. Use taxon_multipliers to skew a baseline, add marker_additions if absent, then renormalize the whole multi-kingdom vector to sum to 1.0.",
    "units": {
      "kingdom_fraction_vector": "relative_abundance; each zone sums to 1.0",
      "taxon_multipliers": "dimensionless multiplicative factors; neutral value is 1.0; not summed",
      "marker_additions": "small relative-abundance priors before final renormalization"
    },
    "application_order": [
      "start_with_coastal_or_open_ocean_profile",
      "multiply_matching_taxa_by_zone_taxon_multipliers",
      "inject_marker_additions_for_missing_taxa",
      "adjust_to_zone_kingdom_fraction_vector",
      "renormalize_total_relative_abundance_to_1.0"
    ],
    "taxonomic_style": "GRUMB/metagenomic-compatible marker names where possible: genus, family, clade, or viral group labels."
  },
