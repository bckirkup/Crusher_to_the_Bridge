# Version control / CI
.git/
.github/
.gitignore

# Python caches / build artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime telemetry artifacts (regenerated inside each container).
# NOTE: telemetry_buffer/ is also a Python package; keep only its modules.
telemetry_buffer/*
!telemetry_buffer/__init__.py
!telemetry_buffer/agent_axes.py
!telemetry_buffer/schema.py
# The bounded designs (Morris screen, feasibility gate) run from this package in
# the Dockerfile.design worker; its modules only, never its result artifacts.
!telemetry_buffer/observation_model/*.py

# Dashboard / GIS-only assets not needed by the headless campaign runner
dashboard/
data/platforms/*/reference_photo.jpg
data/platforms/*/deck_graphics.geojson
data/platforms/*/*.png
data/platforms/*/contam/*.sim
data/platforms/*/contam/*.csm
data/platforms/*/contam/*.rst
data/platforms/*/contam/*.xlog
data/platforms/*/contam/*.log

# Non-redistributable ContamX binaries
third_party/contamx/**

# Local dev cruft
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docs / editor helpers (image only needs runtime code)
.devin/
