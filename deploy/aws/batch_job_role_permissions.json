{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ResultsBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::<BUCKET>",
      "Condition": {
        "StringLike": { "s3:prefix": ["campaign/*"] }
      }
    },
    {
      "Sid": "S3ResultsObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListMultipartUploadParts", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::<BUCKET>/campaign/*"
    }
  ]
}
