# Boundary surface analysis image (CmdStan + analysis extras).
# Build from repo root:
#   docker build -f deploy/aws/Dockerfile.analysis -t picard-boundary-analysis .
#
# NOT for ABM Spot shards — use root Dockerfile / picard-campaign for Phase 1.
#
# Locked uv.lock resolution + wheels-only (Sonar docker:S8541 / S8544), matching root Dockerfile.

FROM python:3.11-slim-bookworm

WORKDIR /app

ENV PYTHONPATH=/app \
    PYTHONUTF8=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_NO_CACHE=1 \
    UV_PYTHON_DOWNLOADS=never \
    PATH=/app/.venv/bin:$PATH \
    CMDSTAN=/opt/cmdstan/cmdstan-2.39.0

COPY --from=ghcr.io/astral-sh/uv:0.7.9 /uv /bin/uv

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        g++ \
        git \
        make \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies first for better layer caching.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --all-extras --no-install-project --no-build \
    && python -c "import cmdstanpy; cmdstanpy.install_cmdstan(dir='/opt/cmdstan')" \
    && useradd --create-home --uid 10001 analysis \
    && chown -R analysis:analysis /app /opt/cmdstan

COPY picard_framework/ ./picard_framework/
COPY crusher_labs/ ./crusher_labs/
COPY engines/ ./engines/
COPY decision_engine/ ./decision_engine/
COPY simulation_utils/ ./simulation_utils/
COPY telemetry_buffer/ ./telemetry_buffer/
COPY schemas/ ./schemas/
COPY data/ ./data/
COPY scripts/ ./scripts/
COPY deploy/aws/boundary_analysis_entrypoint.py ./deploy/aws/boundary_analysis_entrypoint.py
COPY deploy/aws/sentinel_recovery_analysis_entrypoint.py ./deploy/aws/sentinel_recovery_analysis_entrypoint.py
COPY deploy/aws/sentinel_nuts_entrypoint.py ./deploy/aws/sentinel_nuts_entrypoint.py
COPY orchestrator.py ./
COPY orchestrator_chronic.py orchestrator_display.py orchestrator_epoch.py ./
COPY orchestrator_init.py orchestrator_record.py orchestrator_types.py ./

RUN chown -R analysis:analysis /app
USER analysis

# Job definitions supply the worker script as argv[0] (boundary, recovery, or NUTS).
ENTRYPOINT ["python3"]
