# CG-FLOOR-01 corner probe — the bracket image with the
# covid_cg_floor_v1 design file layered on.
#
# FROM the covid_theta_refit_bracket image, so the base already carries
# the refit, floor and bracket designs and every entrypoint; this layer
# adds only the cg_floor design JSON. Engine semantics are bit-identical
# to the refit/attribution generation by construction (same base image
# digest, no code changes); ENGINE_GIT_SHA stays e0d43979, which is what
# run_spec.json records.
#
# Build (from the repository root at a SHA containing the design file):
#   docker build -f deploy/aws/Dockerfile.covid_cg_floor \
#     -t 994254241749.dkr.ecr.us-east-1.amazonaws.com/picard-campaign:campaign-e0d43979-cgfloor .
ARG BASE_IMAGE=994254241749.dkr.ecr.us-east-1.amazonaws.com/picard-campaign:campaign-e0d43979-refit-bracket
FROM ${BASE_IMAGE}

USER root
COPY --chown=campaign:campaign picard_framework/runs/covid_cg_floor_v1_design.json ./picard_framework/runs/covid_cg_floor_v1_design.json
USER campaign

ENTRYPOINT ["python3"]
