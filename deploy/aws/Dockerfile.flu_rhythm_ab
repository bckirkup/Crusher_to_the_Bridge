# FLU-RHYTHM-01 A/B worker — the campaign image plus tools/ and the probe
# entry.
#
# The base picard-campaign image carries engines/, picard_framework/ and data/
# but not tools/; the probe driver imports tools.* helpers, so this layer adds
# the directory wholesale rather than enumerating the shared modules.
#
# Build (from the repository root; the base must be built first):
#   docker build --build-arg ENGINE_GIT_SHA=$(git rev-parse HEAD) -t picard-campaign .
#   docker build -f deploy/aws/Dockerfile.flu_rhythm_ab -t picard-flu-rhythm-ab .
ARG BASE_IMAGE=picard-campaign
FROM ${BASE_IMAGE}

USER root
COPY --chown=campaign:campaign tools/ ./tools/
COPY --chown=campaign:campaign deploy/aws/flu_rhythm_ab_entrypoint.py \
    ./deploy/aws/flu_rhythm_ab_entrypoint.py
COPY --chown=campaign:campaign deploy/aws/dose_challenge_entrypoint.py \
    ./deploy/aws/dose_challenge_entrypoint.py
COPY --chown=campaign:campaign \
    picard_framework/runs/mega_cruise_campaign/flu_rhythm_01_manifest.json \
    ./picard_framework/runs/mega_cruise_campaign/flu_rhythm_01_manifest.json
USER campaign

# The job definition supplies the worker script as argv[0].
ENTRYPOINT ["python3"]
