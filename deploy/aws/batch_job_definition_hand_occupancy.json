{
 "jobDefinitionName": "picard-hand-occupancy",
 "type": "container",
 "retryStrategy": {
  "attempts": 10,
  "evaluateOnExit": [
   {
    "onStatusReason": "Host EC2*",
    "action": "retry"
   },
   {
    "onReason": "OutOfMemoryError*",
    "action": "exit"
   },
   {
    "onExitCode": "137",
    "action": "exit"
   },
   {
    "onExitCode": "0",
    "action": "exit"
   },
   {
    "onReason": "*",
    "action": "retry"
   }
  ]
 },
 "containerProperties": {
  "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/picard-campaign:noro-hand-stat01",
  "command": [
   "deploy/aws/hand_occupancy_entrypoint.py",
   "--s3-prefix",
   "Ref::s3_prefix",
   "--block",
   "Ref::block",
   "--seeds",
   "Ref::seeds"
  ],
  "jobRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-job-role",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-execution-role",
  "resourceRequirements": [
   {
    "type": "VCPU",
    "value": "1"
   },
   {
    "type": "MEMORY",
    "value": "4096"
   }
  ],
  "linuxParameters": {
   "sharedMemorySize": 512
  },
  "environment": [
   {
    "name": "PYTHONUTF8",
    "value": "1"
   },
   {
    "name": "PYTHONPATH",
    "value": "/app"
   }
  ],
  "logConfiguration": {
   "logDriver": "awslogs",
   "options": {
    "awslogs-group": "/aws/batch/picard-campaign",
    "awslogs-region": "<REGION>",
    "awslogs-stream-prefix": "hand-occupancy"
   }
  }
 },
 "propagateTags": true,
 "timeout": {
  "attemptDurationSeconds": 14400
 }
}
