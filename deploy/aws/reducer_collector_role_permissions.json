{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CollectorBoundedList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::<BUCKET>",
      "Condition": {
        "StringLike": { "s3:prefix": ["", "campaign", "campaign/*"] }
      }
    },
    {
      "Sid": "CollectorReadDerivedReceiptsExportsPages",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectAttributes"],
      "Resource": "arn:aws:s3:::<BUCKET>/campaign/_derived/reducer/v1/*"
    },
    {
      "Sid": "CollectorReadReviewedOriginalManifests",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": [
        "arn:aws:s3:::<BUCKET>/campaign/*manifest*",
        "arn:aws:s3:::<BUCKET>/campaign/*/*manifest*"
      ]
    },
    {
      "Sid": "CollectorBatchStatus",
      "Effect": "Allow",
      "Action": [
        "batch:DescribeJobs",
        "batch:ListJobs",
        "batch:DescribeJobDefinitions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CollectorDenyAllMutations",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:RestoreObject",
        "s3:PutObjectAcl",
        "batch:SubmitJob",
        "batch:CancelJob",
        "batch:TerminateJob",
        "batch:RegisterJobDefinition"
      ],
      "Resource": "*"
    }
  ]
}
