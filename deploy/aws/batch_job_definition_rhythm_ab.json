{
  "jobDefinitionName": "picard-rhythm-ab",
  "type": "container",
  "platformCapabilities": [
    "EC2"
  ],
  "containerProperties": {
    "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/picard-campaign:rhythm-ab-v1",
    "command": [
      "deploy/aws/rhythm_ab_entrypoint.py",
      "--s3-prefix",
      "Ref::s3_prefix",
      "--manifest",
      "Ref::manifest",
      "--pathogen-id",
      "Ref::pathogen_id",
      "--arm",
      "Ref::arm"
    ],
    "jobRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-job-role",
    "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-execution-role",
    "resourceRequirements": [
      {
        "type": "VCPU",
        "value": "1"
      },
      {
        "type": "MEMORY",
        "value": "4096"
      }
    ],
    "linuxParameters": {
      "sharedMemorySize": 512
    },
    "environment": [
      {
        "name": "PYTHONUTF8",
        "value": "1"
      },
      {
        "name": "PYTHONPATH",
        "value": "/app"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/aws/batch/picard-campaign",
        "awslogs-region": "<REGION>",
        "awslogs-stream-prefix": "rhythm-ab"
      }
    }
  },
  "parameters": {
    "s3_prefix": "s3://<BUCKET>/campaign/noro_rhythm_01/",
    "manifest": "picard_framework/runs/mega_cruise_campaign/noro_rhythm_01_manifest.json",
    "pathogen_id": "norwalk_gi",
    "arm": "off"
  },
  "retryStrategy": {
    "attempts": 10,
    "evaluateOnExit": [
      {
        "onStatusReason": "Host EC2*",
        "action": "retry"
      },
      {
        "onReason": "OutOfMemoryError*",
        "action": "exit"
      },
      {
        "onExitCode": "137",
        "action": "exit"
      },
      {
        "onExitCode": "0",
        "action": "exit"
      },
      {
        "onReason": "*",
        "action": "retry"
      }
    ]
  },
  "propagateTags": true,
  "timeout": {
    "attemptDurationSeconds": 14400
  }
}
