{
  "jobDefinitionName": "picard-boundary-surface",
  "type": "container",
  "platformCapabilities": ["EC2"],
  "containerProperties": {
    "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/picard-boundary-analysis:latest",
    "command": [
      "deploy/aws/boundary_analysis_entrypoint.py",
      "--phase", "surface",
      "--s3-campaign", "Ref::s3_campaign",
      "--s3-analysis", "Ref::s3_analysis"
    ],
    "jobRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-job-role",
    "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-execution-role",
    "resourceRequirements": [
      { "type": "VCPU", "value": "2" },
      { "type": "MEMORY", "value": "8192" }
    ],
    "linuxParameters": { "sharedMemorySize": 1024 },
    "environment": [
      { "name": "PYTHONUTF8", "value": "1" },
      { "name": "PYTHONPATH", "value": "/app" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/aws/batch/picard-boundary-analysis",
        "awslogs-region": "<REGION>",
        "awslogs-stream-prefix": "boundary-surface"
      }
    }
  },
  "parameters": {
    "s3_campaign": "s3://<BUCKET>/campaign/boundary_surface_v1/",
    "s3_analysis": "s3://<BUCKET>/campaign/boundary_surface_v1/analysis/"
  },
  "retryStrategy": {
    "attempts": 3,
    "evaluateOnExit": [
      { "onStatusReason": "Host EC2*", "action": "retry" },
      { "onReason": "OutOfMemoryError*", "action": "exit" },
      { "onExitCode": "137", "action": "exit" },
      { "onExitCode": "0", "action": "exit" },
      { "onReason": "*", "action": "retry" }
    ]
  },
  "propagateTags": true,
  "timeout": {
    "attemptDurationSeconds": 7200
  }
}
