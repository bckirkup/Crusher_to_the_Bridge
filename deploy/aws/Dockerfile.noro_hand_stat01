# NORO-HAND-STATIONARY-01 worker — the campaign image with a worker
# entry. The occupancy census instruments (tools/noro_diag/hand_occupancy.py
# plus the extended growth_chain_census / fomite_mass_balance) ship inside
# the base image built at the merged SHA; this layer only adds the array
# entrypoint and resets ENTRYPOINT so the job definition's argv[0] is a
# script (the base image's `-m campaign_runner` entrypoint would eat it).
#
# Build (from the repository root; the base must be built first):
#   docker build -t picard-campaign .
#   docker build -f deploy/aws/Dockerfile.noro_hand_stat01 \
#     -t picard-campaign:noro-hand-stat01 .
ARG BASE_IMAGE=picard-campaign
FROM ${BASE_IMAGE}

# Restamp the revision label: this tag is built against a specific merged
# SHA, and the label is what the ledger cites as the provenance pin.
ARG ENGINE_GIT_SHA=unknown
LABEL org.opencontainers.image.revision=${ENGINE_GIT_SHA}
ENV ENGINE_GIT_SHA=${ENGINE_GIT_SHA}

USER root
# The base image carries engines/ and picard_framework/ but not tools/;
# the occupancy drivers live under tools/noro_diag/ so the whole tree is
# added rather than enumerating shared modules.
COPY --chown=campaign:campaign tools/ ./tools/
COPY --chown=campaign:campaign \
    picard_framework/runs/mega_cruise_campaign/noro_dose_refit_01_manifest.json \
    ./picard_framework/runs/mega_cruise_campaign/
COPY --chown=campaign:campaign deploy/aws/hand_occupancy_entrypoint.py \
    ./deploy/aws/hand_occupancy_entrypoint.py
COPY --chown=campaign:campaign deploy/aws/dose_challenge_entrypoint.py \
    ./deploy/aws/dose_challenge_entrypoint.py
USER campaign

# The job definition supplies the worker script as argv[0].
ENTRYPOINT ["python3"]
