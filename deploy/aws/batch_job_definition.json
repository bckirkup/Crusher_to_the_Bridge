{
  "jobDefinitionName": "picard-campaign",
  "type": "container",
  "platformCapabilities": ["EC2"],
  "containerProperties": {
    "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/picard-campaign:latest",
    "command": [
      "--manifest", "Ref::manifest",
      "--shard-count", "Ref::shard_count",
      "--s3-prefix", "Ref::s3_prefix",
      "--natural-history-clock", "Ref::clock",
      "--resume",
      "--timeout", "3600"
    ],
    "jobRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-job-role",
    "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-execution-role",
    "resourceRequirements": [
      { "type": "VCPU", "value": "1" },
      { "type": "MEMORY", "value": "2048" }
    ],
    "linuxParameters": { "sharedMemorySize": 512 },
    "environment": [
      { "name": "PYTHONUTF8", "value": "1" },
      { "name": "PYTHONPATH", "value": "/app" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/aws/batch/picard-campaign",
        "awslogs-region": "<REGION>",
        "awslogs-stream-prefix": "picard-campaign"
      }
    }
  },
  "parameters": {
    "manifest": "picard_framework/runs/mega_cruise_campaign/campaign_manifest.json",
    "shard_count": "200",
    "s3_prefix": "s3://<BUCKET>/campaign/",
    "clock": "hours"
  },
  "retryStrategy": {
    "attempts": 10,
    "evaluateOnExit": [
      { "onStatusReason": "Host EC2*", "action": "retry" },
      { "onReason": "OutOfMemoryError*", "action": "exit" },
      { "onExitCode": "137", "action": "exit" },
      { "onExitCode": "0", "action": "exit" },
      { "onReason": "*", "action": "retry" }
    ]
  },
  "propagateTags": true,
  "timeout": {
    "attemptDurationSeconds": 86400
  }
}
