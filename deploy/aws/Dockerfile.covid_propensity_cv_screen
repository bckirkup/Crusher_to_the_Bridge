# PROPENSITY-CV-01 worker — the e0d43979 campaign-stack image with the
# covid_propensity_cv_screen design file layered on.
#
# The merged tree between e0d43979 (the PROPENSITY-V1 canary's image SHA)
# and d0f03fa3 differs only in docs/, tests/, tools/, deploy/aws/ and
# *runs/*_design.json — no engine, spec, or worker-path change — so the
# cells this image runs are bit-identical in engine semantics to the
# canary generation, and the design's paired_vs_canary diagnostic stays
# valid. ENGINE_GIT_SHA inherited from the base stays e0d43979, which is
# what run_spec.json records.
#
# Build (from the repository root at d0f03fa3 or later):
#   docker build -f deploy/aws/Dockerfile.covid_propensity_cv_screen \
#     -t 994254241749.dkr.ecr.us-east-1.amazonaws.com/picard-campaign:campaign-e0d43979-cvscreen .
ARG BASE_IMAGE=994254241749.dkr.ecr.us-east-1.amazonaws.com/picard-campaign:campaign-e0d43979
FROM ${BASE_IMAGE}

USER root
COPY --chown=campaign:campaign picard_framework/runs/covid_propensity_cv_screen_design.json ./picard_framework/runs/covid_propensity_cv_screen_design.json
USER campaign

ENTRYPOINT ["python3"]
