{
  "jobDefinitionName": "picard-covid-hull",
  "type": "container",
  "platformCapabilities": ["EC2"],
  "containerProperties": {
    "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/picard-campaign:covid-first-look-v2",
    "command": [
      "deploy/aws/covid_hull_entrypoint.py",
      "--phase", "Ref::phase",
      "--stride", "Ref::stride",
      "--s3-prefix", "Ref::s3_prefix",
      "--design", "Ref::design"
    ],
    "jobRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-job-role",
    "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-execution-role",
    "resourceRequirements": [
      { "type": "VCPU", "value": "1" },
      { "type": "MEMORY", "value": "2048" }
    ],
    "linuxParameters": { "sharedMemorySize": 512 },
    "environment": [
      { "name": "PYTHONUTF8", "value": "1" },
      { "name": "PYTHONPATH", "value": "/app" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/aws/batch/picard-campaign",
        "awslogs-region": "<REGION>",
        "awslogs-stream-prefix": "covid-hull"
      }
    }
  },
  "parameters": {
    "phase": "fit",
    "stride": "1",
    "s3_prefix": "s3://<BUCKET>/campaign/covid_first_look_v2/",
    "design": "picard_framework/runs/covid_first_look_v2_design.json"
  },
  "retryStrategy": {
    "attempts": 10,
    "evaluateOnExit": [
      { "onStatusReason": "Host EC2*", "action": "retry" },
      { "onReason": "OutOfMemoryError*", "action": "exit" },
      { "onExitCode": "137", "action": "exit" },
      { "onExitCode": "0", "action": "exit" },
      { "onReason": "*", "action": "retry" }
    ]
  },
  "propagateTags": true,
  "timeout": {
    "attemptDurationSeconds": 10800
  }
}
