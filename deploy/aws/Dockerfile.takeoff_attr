# COVID-TAKEOFF-ATTR-01 worker — the campaign image with the takeoff
# attribution entrypoint and its tools layered on.
#
# Build (from the repository root; the base must be built first):
#   docker build -t picard-campaign .
#   docker build -f deploy/aws/Dockerfile.takeoff_attr -t picard-takeoff-attr .
ARG BASE_IMAGE=picard-campaign
FROM ${BASE_IMAGE}

USER root
COPY --chown=campaign:campaign deploy/aws/covid_hull_entrypoint.py ./deploy/aws/covid_hull_entrypoint.py
COPY --chown=campaign:campaign deploy/aws/covid_boarding_screen_entrypoint.py ./deploy/aws/covid_boarding_screen_entrypoint.py
COPY --chown=campaign:campaign deploy/aws/covid_takeoff_attr_entrypoint.py ./deploy/aws/covid_takeoff_attr_entrypoint.py
COPY --chown=campaign:campaign tools/__init__.py ./tools/__init__.py
COPY --chown=campaign:campaign tools/covid_assay_smoke.py ./tools/covid_assay_smoke.py
COPY --chown=campaign:campaign tools/covid_route_attribution.py ./tools/covid_route_attribution.py
COPY --chown=campaign:campaign tools/covid_takeoff_attribution.py ./tools/covid_takeoff_attribution.py
USER campaign

# The job definition supplies the worker script as argv[0].
ENTRYPOINT ["python3"]
