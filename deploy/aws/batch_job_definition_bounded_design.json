{
  "jobDefinitionName": "picard-bounded-design",
  "type": "container",
  "platformCapabilities": ["EC2"],
  "containerProperties": {
    "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/picard-boundary-analysis:bounded-design-v6",
    "command": [
      "deploy/aws/bounded_design_entrypoint.py",
      "--design", "Ref::design",
      "--platform", "Ref::platform",
      "--shard-count", "Ref::shard_count",
      "--trajectories", "Ref::trajectories",
      "--seed-shards", "Ref::seed_shards",
      "--only-points", "Ref::only_points",
      "--crew-duty-exclusion", "Ref::crew_duty_exclusion",
      "--service-surface-knockout", "Ref::service_surface_knockout",
      "--factor-set", "Ref::factor_set",
      "--contact-class-exponent", "Ref::contact_class_exponent",
      "--near-field-retained-fraction", "Ref::near_field_retained_fraction",
      "--near-field-neighbour-table-ratio", "Ref::near_field_neighbour_table_ratio",
      "--activity-contacts", "Ref::activity_contacts",
      "--sobol-m", "Ref::sobol_m",
      "--seeds", "Ref::seeds",
      "--seed-base", "Ref::seed_base",
      "--design-seed", "Ref::design_seed",
      "--s3-prefix", "Ref::s3_prefix"
    ],
    "jobRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-job-role",
    "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-execution-role",
    "resourceRequirements": [
      { "type": "VCPU", "value": "1" },
      { "type": "MEMORY", "value": "4096" }
    ],
    "linuxParameters": { "sharedMemorySize": 512 },
    "environment": [
      { "name": "PYTHONUTF8", "value": "1" },
      { "name": "PYTHONPATH", "value": "/app" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/aws/batch/picard-boundary-analysis",
        "awslogs-region": "<REGION>",
        "awslogs-stream-prefix": "bounded-design"
      }
    }
  },
  "parameters": {
    "design": "screen",
    "platform": "classic_cruise_1900",
    "shard_count": "200",
    "trajectories": "20",
    "seed_shards": "10",
    "only_points": "all",
    "crew_duty_exclusion": "off",
    "service_surface_knockout": "off",
    "factor_set": "norovirus",
    "contact_class_exponent": "0",
    "near_field_retained_fraction": "0",
    "near_field_neighbour_table_ratio": "0",
    "activity_contacts": "off",
    "sobol_m": "7",
    "seeds": "30",
    "seed_base": "500",
    "design_seed": "17",
    "s3_prefix": "s3://<BUCKET>/campaign/bounded_design_v2/"
  },
  "retryStrategy": {
    "attempts": 10,
    "evaluateOnExit": [
      { "onStatusReason": "Host EC2*", "action": "retry" },
      { "onReason": "OutOfMemoryError*", "action": "exit" },
      { "onExitCode": "137", "action": "exit" },
      { "onExitCode": "0", "action": "exit" },
      { "onReason": "*", "action": "retry" }
    ]
  },
  "propagateTags": true,
  "timeout": {
    "attemptDurationSeconds": 43200
  }
}
