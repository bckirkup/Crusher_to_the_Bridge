# CREW-WINDOW-01 crew-channel probe — the campaign-b4207e5f
# campaign_stack image with the b4207e5f..<merge> diff layered on.
#
# FROM campaign-b4207e5f (the full campaign_stack built at merge
# b4207e5f on 2026-10-05), so the base already carries deploy/aws/,
# tools/, data/ and every design file at that SHA. The layer carries the
# merged tree forward: HOST-AGE adjacencies that landed before b4207e5f
# are in the base; this overlay adds the b4207e5f..<merge> delta —
# PR #906 (crew-window arm grammar + protocols + design), PR #907,
# PR #908 (ALIGNMENT-CLEANUP-01: susceptibility_age_mode switch, flu
# home surfaces, tools/diag consolidation), and the droplet_field_split
# delivery echo — so the image's engine tree is identical to the merged
# campaign SHA. The in-design D0_declared rows are the drift witness
# against earlier-generation cells of record.
#
# Stale-path cleanup: ALIGNMENT-CLEANUP-01 folded tools/readout_stats.py
# into tools/diag/readout_common.py; the base still carries the old file,
# so it is removed here (readout_stats importers were repointed at
# merge). telemetry_buffer/info_suppress_probe.py moved to
# tools/covid_info_suppress_probe.py but telemetry_buffer/ is not in the
# image, so only the new path is copied.
#
# Build (from the repository root at the merged SHA):
#   docker build -f deploy/aws/Dockerfile.covid_crew_window \
#     --build-arg ENGINE_SHA=<merged-sha> \
#     -t 994254241749.dkr.ecr.us-east-1.amazonaws.com/picard-campaign:campaign-<sha>-crewwindow .
ARG BASE_IMAGE=994254241749.dkr.ecr.us-east-1.amazonaws.com/picard-campaign:campaign-b4207e5f
FROM ${BASE_IMAGE}

USER root
RUN rm -f /app/tools/readout_stats.py
COPY --chown=campaign:campaign data/config/protocols.json ./data/config/protocols.json
COPY --chown=campaign:campaign data/observation/flu_fit_targets.json ./data/observation/flu_fit_targets.json
COPY --chown=campaign:campaign data/pathogens/edison_10pathogen_profiles.json ./data/pathogens/edison_10pathogen_profiles.json
COPY --chown=campaign:campaign data/pathogens/norwalk_only.json ./data/pathogens/norwalk_only.json
COPY --chown=campaign:campaign engines/transmission_core.py ./engines/transmission_core.py
COPY --chown=campaign:campaign orchestrator_epoch.py ./orchestrator_epoch.py
COPY --chown=campaign:campaign orchestrator_init.py ./orchestrator_init.py
COPY --chown=campaign:campaign picard_framework/covid_boarding_screen.py ./picard_framework/covid_boarding_screen.py
COPY --chown=campaign:campaign picard_framework/runs/covid_crew_window_01_design.json ./picard_framework/runs/covid_crew_window_01_design.json
COPY --chown=campaign:campaign picard_framework/runs/mega_cruise_campaign/noro_food_02_manifest.json ./picard_framework/runs/mega_cruise_campaign/noro_food_02_manifest.json
COPY --chown=campaign:campaign schemas/flu_fit_targets.schema.json ./schemas/flu_fit_targets.schema.json
COPY --chown=campaign:campaign tools/cabin_floor_probe.py ./tools/cabin_floor_probe.py
COPY --chown=campaign:campaign tools/covid_info_suppress_probe.py ./tools/covid_info_suppress_probe.py
COPY --chown=campaign:campaign tools/covid_seed_ring_burn.py ./tools/covid_seed_ring_burn.py
COPY --chown=campaign:campaign tools/diag/conditioned_cell.py ./tools/diag/conditioned_cell.py
COPY --chown=campaign:campaign tools/diag/readout_common.py ./tools/diag/readout_common.py
COPY --chown=campaign:campaign tools/flu_anchors.py ./tools/flu_anchors.py
COPY --chown=campaign:campaign tools/flu_confined_dose_probe.py ./tools/flu_confined_dose_probe.py
COPY --chown=campaign:campaign tools/flu_present_ab_score.py ./tools/flu_present_ab_score.py
COPY --chown=campaign:campaign tools/flu_rhythm_ab_probe.py ./tools/flu_rhythm_ab_probe.py
COPY --chown=campaign:campaign tools/flu_rhythm_ab_readout.py ./tools/flu_rhythm_ab_readout.py
COPY --chown=campaign:campaign tools/noro_diag/import_yield_probe.py ./tools/noro_diag/import_yield_probe.py
COPY --chown=campaign:campaign tools/noro_diag/venue_census_readout.py ./tools/noro_diag/venue_census_readout.py
COPY --chown=campaign:campaign tools/sanity_checker.py ./tools/sanity_checker.py
COPY --chown=campaign:campaign tools/smalln_diag/confined_challenge_trace.py ./tools/smalln_diag/confined_challenge_trace.py
USER campaign

ARG ENGINE_SHA=unknown
ENV ENGINE_GIT_SHA=${ENGINE_SHA}
ENTRYPOINT ["python3"]
