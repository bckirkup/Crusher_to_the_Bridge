{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReducerListApprovedOriginalsAndDerived",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::<BUCKET>",
      "Condition": {
        "StringLike": { "s3:prefix": ["campaign", "campaign/*"] }
      }
    },
    {
      "Sid": "ReducerReadApprovedOriginalsAndDerived",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectAttributes"],
      "Resource": "arn:aws:s3:::<BUCKET>/campaign/*"
    },
    {
      "Sid": "ReducerDerivedCreateOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:ListMultipartUploadParts", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::<BUCKET>/campaign/_derived/reducer/v1/*"
    },
    {
      "Sid": "ReducerDenyObjectMutations",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:RestoreObject",
        "s3:PutObjectAcl",
        "s3:PutObjectTagging",
        "s3:DeleteObjectTagging"
      ],
      "Resource": "arn:aws:s3:::<BUCKET>/campaign/*"
    }
  ]
}
