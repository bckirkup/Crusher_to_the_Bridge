{
  "jobDefinitionName": "picard-covid-boarding-screen-fargate",
  "type": "container",
  "platformCapabilities": [
    "FARGATE"
  ],
  "containerProperties": {
    "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/picard-campaign@sha256:<IMAGE_DIGEST>",
    "command": [
      "deploy/aws/covid_boarding_screen_entrypoint.py",
      "--stride",
      "Ref::stride",
      "--s3-prefix",
      "Ref::s3_prefix",
      "--design",
      "Ref::design",
      "--index-offset",
      "Ref::index_offset"
    ],
    "jobRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-job-role",
    "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/picard-campaign-execution-role",
    "resourceRequirements": [
      {
        "type": "VCPU",
        "value": "1"
      },
      {
        "type": "MEMORY",
        "value": "4096"
      }
    ],
    "networkConfiguration": {
      "assignPublicIp": "ENABLED"
    },
    "fargatePlatformConfiguration": {
      "platformVersion": "LATEST"
    },
    "environment": [
      {
        "name": "PYTHONUTF8",
        "value": "1"
      },
      {
        "name": "PYTHONPATH",
        "value": "/app"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/aws/batch/picard-campaign",
        "awslogs-region": "<REGION>",
        "awslogs-stream-prefix": "covid-boarding-screen-fargate"
      }
    }
  },
  "parameters": {
    "stride": "1",
    "s3_prefix": "s3://<BUCKET>/campaign/covid_quar_suppression_v1/",
    "design": "picard_framework/runs/covid_quar_suppression_v1_design.json",
    "index_offset": "0"
  },
  "retryStrategy": {
    "attempts": 10,
    "evaluateOnExit": [
      {
        "onStatusReason": "Host EC2*",
        "action": "retry"
      },
      {
        "onReason": "OutOfMemoryError*",
        "action": "exit"
      },
      {
        "onExitCode": "137",
        "action": "exit"
      },
      {
        "onExitCode": "0",
        "action": "exit"
      },
      {
        "onReason": "*",
        "action": "retry"
      }
    ]
  },
  "propagateTags": true,
  "timeout": {
    "attemptDurationSeconds": 10800
  }
}
