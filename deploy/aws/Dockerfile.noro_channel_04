# NORO-CHANNEL-04 worker — overlay on the NORO-CHANNEL-03 campaign image.
# The base layers' engines tree sits at bc4de6f5 (the channel-03 overlay
# copied only its own driver+entrypoints), so copying only files changed
# since d6c51c14 would mix two engine vintages — ENV-HAZARD-01's
# engines/environmental_hazards.py, added before d6c51c14, was already
# missing from the base and the first build of this overlay failed on
# exactly that import. This overlay therefore copies the full root
# Dockerfile scope: the image then equals the merge-SHA tree for every
# image-visible path regardless of which campaign layered what below.
#
# Build (from the repository root; the base must exist in ECR):
#   docker build -f deploy/aws/Dockerfile.noro_channel_04 \
#     --build-arg BASE_IMAGE=<acct>.dkr.ecr.<region>.amazonaws.com/picard-campaign:noro-channel-03-d6c51c14 \
#     -t <acct>.dkr.ecr.<region>.amazonaws.com/picard-campaign:noro-channel-04-<sha> .
ARG BASE_IMAGE=picard-campaign:noro-channel-03-d6c51c14
FROM ${BASE_IMAGE}

# Restamp the engine revision: the base image's ENGINE_GIT_SHA names ITS
# build SHA; runs from this overlay must record THIS layer's source SHA
# (pass --build-arg ENGINE_GIT_SHA=$(git rev-parse HEAD)).
ARG ENGINE_GIT_SHA=unknown
LABEL org.opencontainers.image.revision=${ENGINE_GIT_SHA}
ENV ENGINE_GIT_SHA=${ENGINE_GIT_SHA}

USER root
# Full root-Dockerfile COPY scope at the merge SHA.
COPY --chown=campaign:campaign picard_framework/ ./picard_framework/
COPY --chown=campaign:campaign crusher_labs/ ./crusher_labs/
COPY --chown=campaign:campaign engines/ ./engines/
COPY --chown=campaign:campaign decision_engine/ ./decision_engine/
COPY --chown=campaign:campaign simulation_utils/ ./simulation_utils/
COPY --chown=campaign:campaign telemetry_buffer/ ./telemetry_buffer/
COPY --chown=campaign:campaign data/ ./data/
COPY --chown=campaign:campaign schemas/ ./schemas/
COPY --chown=campaign:campaign presidio/data/ ./presidio/data/
COPY --chown=campaign:campaign orchestrator.py ./
COPY --chown=campaign:campaign orchestrator_chronic.py \
    orchestrator_display.py orchestrator_epoch.py ./
COPY --chown=campaign:campaign orchestrator_init.py \
    orchestrator_record.py orchestrator_types.py ./
# tools/ wholesale (same pattern as the outbreak-01 overlay): the funnel
# driver with caregiver capture, the channel_03 readout with the split
# rendering, per_host_dose_challenge and any sibling tool changes.
COPY --chown=campaign:campaign tools/ ./tools/
# The worker pair the entrypoint/driver contract needs.
COPY --chown=campaign:campaign deploy/aws/noro_channel_03_entrypoint.py \
    ./deploy/aws/noro_channel_03_entrypoint.py
COPY --chown=campaign:campaign deploy/aws/dose_challenge_entrypoint.py \
    ./deploy/aws/dose_challenge_entrypoint.py
COPY --chown=campaign:campaign \
    picard_framework/runs/mega_cruise_campaign/noro_outbreak_01_manifest.json \
    ./picard_framework/runs/mega_cruise_campaign/noro_outbreak_01_manifest.json
USER campaign

# The job definition supplies the worker script as argv[0].
ENTRYPOINT ["python3"]
